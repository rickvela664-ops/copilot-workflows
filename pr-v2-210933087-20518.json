low-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.png\" alt=\"Low severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> Clarify changelog entry requirements for user-visible changes</summary>\n\n`.github/\u200bcopilot-instructions.md:84`\n\n[General] This reads as an instruction to create a changelog entry for every user-visible change, which conflicts with `CONTRIBUTING.md:11-13`: normal changes rely on generated release notes, and hand-written entries are only for deprecations or breaking changes. Make the condition explicit so reviewers do not request unnecessary entries.\n</details>\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced","comment_id":null,"key":"review:5485624600","kind":"body","line":null,"path":null,"review_id":5485624600}],"frozen_at":1791775765,"frozen_at_iso":"2026-10-12T03:29:25Z","frozen_sha":"94bb56f6bc42cc77da8b79c30a861b241aef6e41","head_ref":"trask-changelog-review-guidance","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38199929508},"loop_kind":"copilot_review","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nGuide agents to describe released behavior and required migration in changelog entries, without references to former preview gates or unnecessary statements about unchanged behavior.\n\nDocument flat properties without repeating equivalent declarative configuration. Include declarative configuration only when behavior, migration, or supported configuration differs.\n\nAvoid duplicate flat-property and declarative behavior tests that use shared configuration logic. Keep focused declarative coverage for different behavior, new or changed mode-specific wiring or migration paths, and YAML-only settings.","title":"Clarify changelog and configuration review guidance"},"mode":"publish","pr":20518,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791775767,"generation":1,"max_pipelines":5,"phase":"7d0629fb49ff4a0bab462e52c8b47482","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"482de595dd8e47c18fdd5f08898d4bb0","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/ad6a64e8dc14135373bf97b7702ff40449bb2704","workflow_revision":"ad6a64e8dc14135373bf97b7702ff40449bb2704"},"run":{"attempt":1,"conclusion":"success","id":38199977434,"url":"https://github.com/trask/copilot-workflows/actions/runs/38199977434"},"schema":2,"seen_findings":["5d9d160f9dff17a02f545af3bfa6f333e0dca01820f1631f5c22e4aa75c7324a"],"seen_inline_findings":[],"seen_missed_findings":["f9afab29c95e6a1a3f971cf1b3c2b62d8ef827cfc477d04ca5ff781b55e0e936"],"stage":"thread_effects","verification_run":{"attempt":1,"id":38200673160}}