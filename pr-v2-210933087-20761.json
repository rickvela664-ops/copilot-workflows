zen_at":1792602171,"frozen_at_iso":"2026-10-21T17:02:51Z","frozen_sha":"22ca7c4ecd8c3a996074b304dc84aada8ea61f16","head_ref":"trask-explicit-only-instrumenter-schemas","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":39640224042},"loop_kind":"pr_conflict_resolver","merge_base_sha":"ae286582ee0a39c6fb86529cfa316c3c25a4c5cb","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nMake `InstrumenterBuilder.setSchemaUrl(...)` the only source of the schema URL shared by spans, operation metrics, and exception logs. The schema identifies the conventions defining those signals, independent of supporting attributes.\n\n```diff\n Instrumenter.<Request, Response>builder(openTelemetry, \"my-instrumentation\", spanNameExtractor)\n+    .setSchemaUrl(\"https://opentelemetry.io/schemas/1.41.0\")\n     .addAttributesExtractor(attributesExtractor)\n     .buildInstrumenter();\n```\n\n**Breaking change:** Builders that relied on attribute-derived schemas must add the setter shown above. Without it, telemetry has no schema URL in any mode. Explicit custom URLs remain supported.\n\nFourth and final layer on #20760, tracking #20755.","title":"Require explicit Instrumenter schema selection"},"mode":"publish","pr":20761,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792602171,"generation":2,"max_pipelines":5,"phase":"2175ea4368e44ef8848346f947b55c22","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"ce221af47f5d47158cf3daf170f5ae3a","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/4beaaf0c4795a1d021c4bba5c754ee2c642b30b0","workflow_revision":"4beaaf0c4795a1d02