zen_at":1792596232,"frozen_at_iso":"2026-10-21T15:23:52Z","frozen_sha":"22ca7c4ecd8c3a996074b304dc84aada8ea61f16","head_ref":"trask-explicit-only-instrumenter-schemas","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":39625239820},"loop_kind":"pr_conflict_resolver","merge_base_sha":"ae286582ee0a39c6fb86529cfa316c3c25a4c5cb","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nMake `InstrumenterBuilder.setSchemaUrl(...)` the only source of the schema URL shared by spans, operation metrics, and exception logs. The schema identifies the conventions defining those signals, independent of supporting attributes.\n\n```diff\n Instrumenter.<Request, Response>builder(openTelemetry, \"my-instrumentation\", spanNameExtractor)\n+    .setSchemaUrl(\"https://opentelemetry.io/schemas/1.41.0\")\n     .addAttributesExtractor(attributesExtractor)\n     .buildInstrumenter();\n```\n\n**Breaking change:** Builders that relied on attribute-derived schemas must add the setter shown above. Without it, telemetry has no schema URL in any mode. Explicit custom URLs remain supported.\n\nFourth and final layer on #20760, tracking #20755.","title":"Require explicit Instrumenter schema selection"},"mode":"publish","pr":20761,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792596232,"generation":1,"max_pipelines":5,"phase":"2b6725bfdabf4c5f92546cc49d0a3ee9","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"9fb30eb00f8b4b23aeb3904154029c65","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/702f9d0316fccd229b4e90e9a01723d297e91b81","workflow_revision":"702f9d0316fccd229