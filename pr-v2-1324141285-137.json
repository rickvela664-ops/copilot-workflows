os/database/java/redis/lettuce/opentelemetry-library/data.json","scenarios/database/java/redis/rediscala/opentelemetry-javaagent/data.json"],"commit":"d26c897f9f7cecf4dcda85ab726b77fd1f7577b4","commits":[{"changed_paths":["scenarios/database/contracts/redis-lettuce.yaml","scenarios/database/java/README.md","scenarios/database/java/redis/lettuce/opentelemetry-library/data.json","scenarios/database/java/redis/rediscala/opentelemetry-javaagent/data.json"],"commit":"d26c897f9f7cecf4dcda85ab726b77fd1f7577b4","parent":"237a02482405680fb0d22e61beca8582553bb0d7","patch_sha256":"86b3203f8a2cdcd3af65354a3775d0b2238e3e3a1ef298732e619990c659dd5d","subject":"Align Redis expectations and coverage with current instrumentation","tree":"ea9f26a75734bb5b8c1ae3b5c95c55cf3a0d022e"}],"cumulative_patch_sha256":"86b3203f8a2cdcd3af65354a3775d0b2238e3e3a1ef298732e619990c659dd5d","finding_commits":{},"parent":"237a02482405680fb0d22e61beca8582553bb0d7","patch_sha256":"86b3203f8a2cdcd3af65354a3775d0b2238e3e3a1ef298732e619990c659dd5d","tree":"ea9f26a75734bb5b8c1ae3b5c95c55cf3a0d022e"},"dispositions":{"diagnoses":[{"analysis":"The aggregate required-status-check correctly fails when needs.scenarios.result is not success (.github/workflows/runner.yml:728-746). Frozen evidence identifies Scenarios (database-java) as the only failed prerequisite; its Lettuce expectation failures and stale Redis coverage cause this downstream exit. The candidate fixes those causes without weakening the aggregate gate or editing the workflow.","decision":"fix","evidence":["Run exit 1","Process completed with exit code 1."],"key":"check:114959909360"},{"analysis":"Both Lettuce agent and standalone instrumentation emit the Redis server code WRONGTYPE for the rejected LPUSH, but the shared contract asserts a Java exception class. The candidate expects WRONGTYPE and documents the distinction, preserving the workload and exact error assertion. The same frozen run also reports stale data.json files: Lettuce library coverage adds service.instance.id, and Rediscala span and operation-duration coverage add db.namespace. Both files are updated byte-for-byte to the CI-generated Git blobs aaf8c71 and b0ab683. The description correction removes only the independently disproved Rediscala namespace-gap claim. Focused checks pass; full Docker scenario execution is unavailable in this worker.","decision":"fix","evidence":["error.type expected 'io.lettuce.core.RedisCommandExecutionException' on every span, saw ['WRONGTYPE']","index a535386..aaf8c71 100644","index b9bbbf5..b0ab683 100644","the committed data.json files are out of date \u2014 run the scenarios and commit the result"],"key":"check:114954001677"}],"input_identity":{"pr_diff_sha256":"e5e316865a60abad7bd26b437dd04b6452f266ecc38c7b84a13dbe13783dbede"},"outcome":"fixes","proposal":{"body":"Adds Java Redis semantic-convention conformance for Jedis, Lettuce, Rediscala, and Redisson. All four clients run through the OpenTelemetry Java agent, and Lettuce also runs through the standalone `opentelemetry-lettuce-5.1` instrumentation.\n\nThe scenarios cover reads, writes, pipelines or transactions, and `WRONGTYPE` failures against Redis 8.2.1. Contracts classify spans as `db.redis.client` and record each client's emitted attributes.\n\n### Known instrumentation gaps\n\nJedis does not mark rejected `LPUSH` spans as errors. Rediscala does not emit `db.query.text`.","title":"Add Java Redis client conformance"},"request_digest":"a2c7a05a2d79c5bc987789fd2523b1a9fd87af22f9b0cf4f2dd28a073a8612b0","rerun_run":null,"schema":2},"download_sha256":"379ae166b021ab33d67ed731a3e9fe76a71342d39f1b5ae75774ccbfe54a0e06","frozen_sha":"237a02482405680fb0d22e61beca8582553bb0d7","pr":137,"publication_eligible":false,"repo":"open-telemetry/semantic-conventions-conformance","request_digest":"a2c7a05a2d79c5bc987789fd2523b1a9fd87af22f9b0cf4f2dd28a073a8612b0","request_id":"a60d34c4ab8e4d3b85cf8381c4b274a1","run_attempt":1,"run_id":38317524991,"schema":2,"scope":"Structura