560a23e21e91b7a9edeb3503f6e14928d896ba2","commits":[],"cumulative_patch_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","finding_commits":{},"parent":"9560a23e21e91b7a9edeb3503f6e14928d896ba2","patch_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","tree":"9a0adade442052a632b24df907d7a0fb5f0f0b9a"},"dispositions":{"comments":[{"body":"Structured-output requests bypass this instrumentation. In OpenAI SDK 2.20.1, within the declared supported version range, `create` and `createStreaming` also accept `StructuredResponseCreateParams<T>`. These overloads fail this parameter-type check and are invoked on the raw delegate, so their internal calls with `rawParams()` never re-enter the proxy. Using the frozen wrappers with that SDK, ordinary requests exported one span each, but structured synchronous/asynchronous requests and streams all exported zero. Route the structured overloads through the instrumented path in both service wrappers, preserving their structured return type, and cover them against a supporting SDK version.","line":41,"path":"instrumentation/openai/openai-java-1.1/library/src/main/java/io/opentelemetry/instrumentation/openai/v1_1/InstrumentedResponseService.java","side":"RIGHT"},{"body":"Calling `withOptions(...)` drops the Responses instrumentation. On SDK 2.20.1, `client.responses().withOptions(b -> b.maxRetries(0)).create(params)` reaches this fallback, which returns the delegate's unwrapped `ResponseServiceAsync`; the synchronous wrapper has the same problem. Real requests through both modified services succeeded but exported zero spans, while the same requests without `withOptions` exported one each. Intercept this service-view method and wrap its returned service with the same instrumenter in both wrappers so per-service option overrides retain telemetry.","line":64,"path":"instrumentation/openai/openai-java-1.1/library/src/main/java/io/opentelemetry/instrumentation/openai/v1_1/InstrumentedResponseServiceAsync.java","side":"RIGHT"}],"input_identity":{"pr_diff_sha256":"b8574a18c9c8d2b7ce7221a3689d50ccffc382633146806290fdff76551d53c4"},"outcome":"comments","request_digest":"542b8ed9f7cd14af922947bcd4b86f85c7fe9d6636d645c1fcfb41ee5560cd85","schema":2},"download_sha256":"e241a199b4c92adba46ec7fa22584d830982ee6bfeb55adb5ea11c6a15bbbdb3","frozen_sha":"9560a23e21e91b7a9edeb3503f6e14928d896ba2","pr":20537,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"542b8ed9f7cd14af922947bcd4b86f85c7fe9d6636d645c1fcfb41ee5560cd85","request_id":"4a55b170119f483d8974236ef50d99a8","run_attempt":1,"run_id":39155515860,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:e241a199b4c92adba46ec7fa22584d830982ee6bfeb55adb5ea11c6a15bbbdb3","verification":"verified","verification_run":{"attempt":1,"id":39157297949},"workflow_revision":"9c5098a3d18066ad5638649233da6db52445d29f"},"request":{"authorized_actor_id":218610,"base_ref":"main","base_sha":"a16167261a6240d5f070e96135e92efa10537f1e","baseline_review_ids":[],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[],"frozen_at":1792349010,"frozen_at_iso":"2026-10-18T18:43:30Z","frozen_sha":"9560a23e21e91b7a9edeb3503f6e14928d896ba2","head_ref":"feat/openai-responses","head_repo":"sangkyoonnam/opentelemetry-java-instrumentation","head_repo_id":1409607073,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":39155452711},"loop_kind":"pr_review","merge_base_sha":"4a40aeffabcf9c5b717504bc5e4bd9f5e4da0c7d","mode":"publish","pr":20537,"pr_author_id":354771,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792349011,"generation":3,"max_pipelines":5,"phase":"e8638357e73b483e8a3212296f36fab5","profile":"git-candidate-v1","requ