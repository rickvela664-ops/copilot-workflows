e.kts","instrumentation/apache-dubbo-2.7/library-autoconfigure/src/main/java/io/opentelemetry/instrumentation/apachedubbo/v2_7/TracingFilter.java"],"commit":"1924acb035386ef9bbb0608b57ed5af5b81e343c","parent":"b6b0d6f90987a435bd467d5855d16eb3f9a97c66","patch_sha256":"bbcd564e5b1e33e7ff1f1e17086128fdfa73575a020a45a1f6207df61539d821","subject":"Support Dubbo 2.7.2 provider completion stages","tree":"f65ae46bed41616691a434c7c440506b1ad7741d"},{"changed_paths":["instrumentation/apache-dubbo-2.7/library-autoconfigure/src/main/java/io/opentelemetry/instrumentation/apachedubbo/v2_7/TracingFilter.java","instrumentation/apache-dubbo-2.7/library-autoconfigure/src/test/java/io/opentelemetry/instrumentation/apachedubbo/v2_7/TracingFilterTest.java"],"commit":"a631e64e3399b0ed780edc6cbbf5dc1bbceb7edb","parent":"1924acb035386ef9bbb0608b57ed5af5b81e343c","patch_sha256":"ecb5fa5934bcc403a03509a2b5405a0b2bfd9bc15545e53b41d561b089fd960a","subject":"Isolate Dubbo provider completion from telemetry failures","tree":"6149d5ef655f6260efc7a3b4f2c751a14df4bddd"}],"cumulative_patch_sha256":"be77d6d323ebcf7eafac116db4c1c2323bbecd9c39498f6238f55e414ef5520b","finding_commits":{"inline:4315759746":"1924acb035386ef9bbb0608b57ed5af5b81e343c","inline:4315759828":"a631e64e3399b0ed780edc6cbbf5dc1bbceb7edb"},"parent":"b0570b1f9337a333799aa6c407832deb0e8bad83","patch_sha256":"be77d6d323ebcf7eafac116db4c1c2323bbecd9c39498f6238f55e414ef5520b","tree":"6149d5ef655f6260efc7a3b4f2c751a14df4bddd"},"dispositions":{"findings":[{"analysis":"Verified Dubbo 2.7.2 AsyncRpcResult extends AbstractResult, which extends CompletableFuture<Result>, and neither cached completion method is available. Added a CompletionStage fallback and a pinned agent-backed 2.7.2 suite alongside 2.7.0, with delayed success/failure assertions in legacy, preview, and duplicate RPC semconv modes. All modes passed; removing the fallback made both 2.7.2 delayed cases fail.","commit":2,"disposition":"fixed","key":"inline:4315759746"},{"analysis":"Verified Dubbo 2.7.5 whenCompleteWithContext replaces responseFuture with its dependent stage and calls context restoration after the callback without finally. Provider completion now catches and logs telemetry failures inside the callback. A throwing onEnd extractor regression verifies the successful response, restoration of both completion-thread RpcContext instances, and one end invocation. The regression passed with the guard and failed with CompletionException caused by telemetry failure when the guard was removed.","commit":3,"disposition":"fixed","key":"inline:4315759828"}],"input_identity":{},"outcome":"fixes","proposal":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nKeep Dubbo provider spans recording until asynchronous results complete, capturing the full duration and failures carried by either the future or response. Port only the Dubbo slice from #20675, stacked on #20721.\n\n- **Compatibility:** Use `Result.whenCompleteWithContext` where available, `AsyncRpcResult.getResultFuture` on 2.7.0, and a `CompletionStage` fallback on 2.7.2; preserve client and synchronous behavior.\n- **Coverage:** Add direct completion/error tests and shared delayed-provider integration tests for library and javaagent instrumentation, retaining legacy, RPC preview, and duplicate telemetry assertions. Pin additional javaagent suites to Dubbo 2.7.0 and 2.7.2.","title":"End Dubbo provider spans on asynchronous completion"},"request_digest":"57781b2bca1313d8d69ff6a40e976673f7fa2c22a94bcc6b6be540ac5e6264fb","schema":2},"download_sha256":"d79bc124ce729b5f24117e1a0a234f82491dc10650b95c3f2617ae9afe492fa4","frozen_sha":"b0570b1f9337a333799aa6c407832deb0e8bad83","pr":20728,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"57781b2bca1313d8d69ff6a40e976673f7fa2c22a94bcc6b6be540ac5e6264fb","request_id":"488c6bcdcd594f19b7ae480580b0e093","run_attempt":1,"run_id":39354787023,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:d79bc124ce729b5f24117e1a0a234f82491dc10650b95c3f2617ae9afe492fa4","verification":"verified","verification_run":{"attempt":1,"id":39357723383},"workflow_revision":"1cc5e4db6ba59d691172ae66fe4a7ff3b0d1300b"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5574000385],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"[General] Dubbo 2.7.2's `AsyncRpcResult` extends `CompletableFuture<Result>` through `AbstractResult`, but exposes neither of the completion methods detected above. Both handles are null, so this returns false and the provider span ends before a delayed result completes, losing its full duration and terminal failure. Add a `CompletionStage` fallback and exercise the shared delayed-provider test against 2.7.2 as well as 2.7.0.","comment_commit_id":"b0570b1f9337a333799aa6c407832deb0e8bad83","comment_id":4315759746,"key":"inline:4315759746","kind":"inline","line":118,"original_commit_id":"6e8b4c4fe39ec87700a9a4a1ad5a2cf914dd5975","original_line":118,"path":"instrumentation/apache-dubbo-2.7/library-autoconfigure/src/main/java/io/opentelemetry/instrumentation/apachedubbo/v2_7/TracingFilter.java","review_commit_id":"6e8b4c4fe39ec87700a9a4a1ad5a2cf914dd5975","review_id":5574000385,"review_submitted_at":"2026-10-19T15:35:37Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"0ed1980611af21f447ab3d5be3e51b89d75f0a117467a6ea5dde209797ddd854","id":4315759746,"parent":null,"updated_at":"2026-10-19T15:35:37Z"}],"thread_id":"PRRT_kwDODJKVX86t_XfD"},{"body":"[General] Catch and log telemetry failures inside this callback. Dubbo 2.7.5's `whenCompleteWithContext` replaces its response future with the callback's dependent stage and restores `RpcContext` only after the callback returns. If `instrumenter.end` throws, for example from a custom `AttributesExtractor.onEnd`, a successful RPC becomes exceptional and context restoration is skipped. The catch around `MethodHandle.invoke` cannot intercept exceptions captured by that stage. Keep telemetry failures from escaping the callback, and add a regression test with a throwing extractor.","comment_commit_id":"b0570b1f9337a333799aa6c407832deb0e8bad83","comment_id":4315759828,"key":"inline:4315759828","kind":"inline","line":95,"original_commit_id":"6e8b4c4fe39ec87700a9a4a1ad5a2cf914dd5975","original_line":95,"path":"instrumentation/apache-dubbo-2.7/library-autoconfigure/src/main/java/io/opentelemetry/instrumentation/apachedubbo/v2_7/TracingFilter.java","review_commit_id":"6e8b4c4fe39ec87700a9a4a1ad5a2cf914dd5975","review_id":5574000385,"review_submitted_at":"2026-10-19T15:35:37Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"d23f51206b4316d7b3c6c584ac3dd9a79116d69fc6303b9f963a0a3a6aa4cf00","id":4315759828,"parent":null,"updated_at":"2026-10-19T15:35:37Z"}],"thread_id":"PRRT_kwDODJKVX86t_Xf4"}],"frozen_at":1792460416,"frozen_at_iso":"2026-10-20T01:40:16Z","frozen_sha":"b0570b1f9337a333799aa6c407832deb0e8bad83","head_ref":"copilot/pr-3-async-provider-completion","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":39354698154},"loop_kind":"copilot_review","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nKeep Dubbo provider spans recording until asynchronous results complete, capturing the full duration and failures carried by either the future or response. Port only the Dubbo slice from #20675, stacked on #20721.\n\n- **Compatibility:** Use `Result.whenCompleteWithContext` where available and `AsyncRpcResult.getResultFuture` on early 2.7 versions; preserve client and synchronous behavior.\n- **Coverage:** Add direct completion/error tests and shared delayed-provider integration tests for library and javaagent instrumentation, retaining legacy, RPC preview, and duplicate telemetry assertions. Pin an additional javaagent suite to Dubbo 2.7.0.","title":"End Dubbo provider spans on asynchronous completion"},"mode":"publish","pr":20728,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792460418,"generation":2,"max_pipelines":5,"phase":"35abce6c67ba4dd1be3f4e4afe75bb16","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"488c6bcdcd594f19b7ae480580b0e093","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/1cc5e4db6ba59d691172ae66fe4a7ff3b0d1300b","workflow_revision":"1cc5e4db6ba59d691172ae66fe4a7ff3b0d1300b"},"review_request":{"baseline_review_ids":[5574000385,5580014854,5580021653],"baseline_run_ids":[39357911477,39357911538,39357911543,39357912033,39357912048],"claim":"f901620b0cf845f7a8cea852ba9fb6d8","confirmation":{"kind":"submitted_review","review_ids":[5580062021]},"owner":{"attempt":"1","run_id":"39358338831"},"recorded_at":1792462878,"sha":"a631e64e3399b0ed780edc6cbbf5dc1bbceb7edb","status":"confirmed"},"run":{"attempt":1,"conclusion":"success","id":39354787023,"url":"https://github.com/trask/copilot-workflows/actions/runs/39354787023"},"schema":2,"seen_findings":["c7f1defee12df173abb0e76faed04899de7fa32b1c25fc5830eabc3ea0400096"],"seen_inline_findings":["32ae12c6748d4285d615ca188a0ecdea38ec76cecde2b055bf8d10fe40337506","4c12672e92fedc17473c8f6eed4295f86f87