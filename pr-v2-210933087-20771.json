ive_patch_sha256":"416a9b9dd118288274b4a7bf280ef333f2d2467894d6aca258ad87db8a50cc32","finding_commits":{"inline:4328990051":"2129f85384bc2c9799a79737f84c2698a89fd615","review:5590071306":"2129f85384bc2c9799a79737f84c2698a89fd615"},"parent":"804420d9bfa4dc4b9ff50e3d51a2e6fdff4e019f","patch_sha256":"416a9b9dd118288274b4a7bf280ef333f2d2467894d6aca258ad87db8a50cc32","tree":"8b3c1510772f4642aa030badefc358c624971ce8"},"confirmed_at":1792526923,"effect":"push","generation":1,"request_id":"0437532d09c54acfb93774a61bd04d54","sha":"2129f85384bc2c9799a79737f84c2698a89fd615"}],"reason":"pending_fresh_trusted_personal_acceptance","report":{"artifact_id":12294222648,"candidate":{"bundle_sha256":"226e82d369e71e7f79bde79bd1200cdb48ba43d7d710929d4d49c112bc4c2271","changed":true,"changed_paths":["instrumentation/spring/spring-boot-autoconfigure/src/main/java/io/opentelemetry/instrumentation/spring/autoconfigure/OpenTelemetryAutoConfiguration.java","instrumentation/spring/spring-boot-autoconfigure/src/testDeclarativeConfig/java/io/opentelemetry/instrumentation/spring/autoconfigure/DeclarativeConfigTest.java"],"commit":"2129f85384bc2c9799a79737f84c2698a89fd615","commits":[{"changed_paths":["instrumentation/spring/spring-boot-autoconfigure/src/main/java/io/opentelemetry/instrumentation/spring/autoconfigure/OpenTelemetryAutoConfiguration.java","instrumentation/spring/spring-boot-autoconfigure/src/testDeclarativeConfig/java/io/opentelemetry/instrumentation/spring/autoconfigure/DeclarativeConfigTest.java"],"commit":"2129f85384bc2c9799a79737f84c2698a89fd615","parent":"804420d9bfa4dc4b9ff50e3d51a2e6fdff4e019f","patch_sha256":"416a9b9dd118288274b4a7bf280ef333f2d2467894d6aca258ad87db8a50cc32","subject":"Disable flat config fallback in declarative Spring contexts","tree":"8b3c1510772f4642aa030badefc358c624971ce8"}],"cumulative_patch_sha256":"416a9b9dd118288274b4a7bf280ef333f2d2467894d6aca258ad87db8a50cc32","finding_commits":{"inline:4328990051":"2129f85384bc2c9799a79737f84c2698a89fd615","review:5590071306":"2129f85384bc2c9799a79737f84c2698a89fd615"},"parent":"804420d9bfa4dc4b9ff50e3d51a2e6fdff4e019f","patch_sha256":"416a9b9dd118288274b4a7bf280ef333f2d2467894d6aca258ad87db8a50cc32","tree":"8b3c1510772f4642aa030badefc358c624971ce8"},"dispositions":{"findings":[{"analysis":"The overview's single open issue is warranted: an enabled declarative context with a custom OpenTelemetry bean still received the fallback DefaultConfigProperties bean. Commit 1 gates FallbackConfigProperties with DeclarativeConfigDisabled and verifies that declarative contexts expose neither otelProperties nor a ConfigProperties bean. The existing flat-property fallback remains covered and supported.","commit":1,"disposition":"fixed","key":"review:5590071306"},{"analysis":"Reproduced with DeclarativeConfigTest.customOpenTelemetry: the frozen implementation supplied otelProperties as DefaultConfigProperties despite otel.file_format being set. Adding @Conditional(DeclarativeConfigDisabled.class) prevents this flat fallback in declarative mode without changing the ConfigProvider fallback or flat configuration. Regression assertions cover both custom and auto-configured OpenTelemetry contexts; all 111 normal and 36 declarative tests pass.","commit":1,"disposition":"fixed","key":"inline:4328990051"}],"input_identity":{},"outcome":"fixes","request_digest":"94751ae9959d015a445ef5b20c6d7c2ceaf9b4cc220bd6d41410da970400adb7","schema":2},"download_sha256":"222266d4954a129100dcc6013f4dcbd4f8780ab2b5f50e0f3fbb50950035d1a4","frozen_sha":"804420d9bfa4dc4b9ff50e3d51a2e6fdff4e019f","pr":20771,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"94751ae9959d015a445ef5b20c6d7c2ceaf9b4cc220bd6d41410da970400adb7","request_id":"0437532d09c54acfb93774a61bd04d54","run_attempt":1,"run_id":39485265634,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:222266d4954a129100dcc6013f4dcbd4f8780ab2b5f50e0f3fbb50950035d1a4","verification":"verified","verification_run":{"attempt":1,"id":39489170833},"workflow_revision":"702f9d0316fccd229b4e90e9a01723d297e91b81"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5590071306],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nThe fallback still exposes flat/default configuration through `otelProperties` in an enabled declarative context.\n\n<details open>\n<summary><strong>1 open issue</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Disable fallback config bean in declarative mode](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20771#discussion_r4328990051) \u00b7 New\n</details>\n\n<details>\n<summary><strong>What changed in this PR</strong></summary>\n\nRemoves deprecated declarative-to-flat configuration compatibility while preserving the flat-to-declarative bridge and flat-property Spring configuration.\n\n**Changes:**\n- Removes the reverse bridge, its tests, and unused dependencies.\n- Removes the declarative Spring compatibility bean and updates configuration tests.\n- Updates documentation and breaking-change notes.\n\n| File | Description |\r\n| ---- | ----------- |\r\n| instrumentation/\u200bspring/\u200bspring-boot-autoconfigure/\u200bsrc/\u200btestDeclarativeConfig/\u200bjava/\u200bio/\u200bopentelemetry/\u200binstrumentation/\u200bspring/\u200bautoconfigure/\u200bDeclarativeConfigTest.java | Reads configuration through `ConfigProvider`. |\r\n| instrumentation/\u200bspring/\u200bspring-boot-autoconfigure/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200binstrumentation/\u200bspring/\u200bautoconfigure/\u200bOpenTelemetryAutoConfiguration.java | Removes declarative compatibility bean. |\r\n| declarative-config-bridge/\u200bsrc/\u200btest/\u200bjava/\u200bio/\u200bopentelemetry/\u200binstrumentation/\u200bconfig/\u200bbridge/\u200bDeclarativeConfigPropertiesBridgeTest.java | Deletes reverse-bridge tests. |\r\n| declarative-config-bridge/\u200bsrc/\u200btest/\u200bjava/\u200bio/\u200bopentelemetry/\u200binstrumentation/\u200bconfig/\u200bbridge/\u200bDeclarativeConfigPropertiesBridgeBuilderTest.java | Deletes builder tests. |\r\n| declarative-config-bridge/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200binstrumentation/\u200bconfig/\u200bbridge/\u200bDeclarativeConfigPropertiesBridgeBuilder.java | Deletes deprecated builder. |\r\n| declarative-config-bridge/\u200bsrc/\u200bmain/\u200bjava/\u200bio/\u200bopentelemetry/\u200binstrumentation/\u200bconfig/\u200bbridge/\u200bDeclarativeConfigPropertiesBridge.java | Deletes reverse-bridge implementation. |\r\n| declarative-config-bridge/\u200bREADME.md | Describes the remaining bridge. |\r\n| declarative-config-bridge/\u200bbuild.gradle.kts | Removes unused dependencies. |\r\n| CHANGELOG.md | Records removals and migration guidance. |\n</details>\n\n<sub>Review effort: Balanced</sub>","comment_id":null,"key":"review:5590071306","kind":"body","line":null,"path":null,"review_id":5590071306},{"body":"[Config] Removing this bean makes `FallbackConfigProperties` eligible in an enabled declarative context: it requires an `OpenTelemetry` bean and no `ConfigProperties` bean, but does not exclude declarative mode. It therefore recreates `otelProperties` using `DefaultConfigProperties`, so existing consumers silently read flat/default values instead of the active YAML. Add `@Conditional(DeclarativeConfigDisabled.class)` to the fallback so the compatibility bean is actually removed in declarative mode while remaining available for flat configuration.","comment_commit_id":"804420d9bfa4dc4b9ff50e3d51a2e6fdff4e019f","comment_id":4328990051,"key":"inline:4328990051","kind":"inline","line":214,"original_commit_id":"804420d9bfa4dc4b9ff50e3d51a2e6fdff4e019f","original_line":214,"path":"instrumentation/spring/spring-boot-autoconfigure/src/main/java/io/opentelemetry/instrumentation/spring/autoconfigure/OpenTelemetryAutoConfiguration.java","review_commit_id":"804420d9bfa4dc4b9ff50e3d51a2e6fdff4e019f","review_id":5590071306,"review_submitted_at":"2026-10-20T18:56:59Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"abada22bbced1539b8dbfafc07c8df75474ebceba3d4b18e2d77a5f7eba16665","id":4328990051,"parent":null,"updated_at":"2026-10-20T18:56:59Z"}],"thread_id":"PRRT_kwDODJKVX86uegEG"}],"frozen_at":1792525091,"frozen_at_iso":"2026-10-20T19:38:11Z","frozen_sha":"804420d9bfa4dc4b9ff50e3d51a2e6fdff4e019f","head_ref":"copilot/update-api-support-example","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":39485105710},"loop_kind":"copilot_review","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nRemove the deprecated declarative-to-flat bridge and declarative Spring Boot `ConfigProperties` compatibility bean. The supported flat-to-declarative bridge and flat-property Spring configuration remain available.\n\n- **Declarative configuration:** Read settings through `ConfigProvider` and `DeclarativeConfigProperties`:\n  ```java\n  DeclarativeConfigProperties javaConfig =\n      configProvider.getInstrumentationConfig().getStructured(\"java\");\n  ```\n- **Flat-property configuration:** Continue using the Spring `ConfigProperties` bean.","title":"Remove reverse declarative config bridge compatibility"},"mode":"publish","pr":20771,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792525093,"generation":1,"max_pipelines":5,"phase":"da7aacc3763c49e78716583e193020f4","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"0437532d09c54acfb93774a61bd04d54","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/702f9d0316fccd229b4e90e9a01723d297e91b81","workflow_revision":"702f9d0316fccd229b4e90e9a01723d297e91b81"},"run":{"attempt":1,"conclusion":"success","id":39485265634,"url":"https://github.com/trask/copilot-workflows/actions/runs/39485265634"},"schema":2,"seen_findings":["393eb7f77b2a0f5a1fc806f7a23b603c20b3b069edb709b84dec3d6b8e69f868"],"seen_inline_findings":["4f66c73fef5b270e03ca91014588d8ed93d8fdbd28fc40f5f943833afb212009"],"seen_missed_findings":[],"stage":"thread_effects","verification_run":{"attempt":1,"id":39489170833}}