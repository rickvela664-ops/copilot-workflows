8eb836b13602e0b504"},"dispositions":{"findings":[{"analysis":"The frozen catalog assigns com.datastax.oss:java-driver-core version 4.3.1 to the early-driver launcher, and scenarios/database/README.md:7-9 explicitly preserves distinct 4.0-4.3 and 4.4+ instrumentation coverage. The new file/package-scoped Renovate rule caps only that coordinate in the database catalog at <4.4. Native Renovate matching and Maven release filtering confirm 4.3 patch updates remain allowed, 4.4+ is rejected, and Apache driver updates and other catalogs are unchanged.","commit":1,"disposition":"fixed","key":"review:5646321421"},{"analysis":"The frozen catalog assigns com.datastax.oss:java-driver-core version 4.3.1 to the early-driver launcher, and scenarios/database/README.md:7-9 explicitly preserves distinct 4.0-4.3 and 4.4+ instrumentation coverage. The new file/package-scoped Renovate rule caps only that coordinate in the database catalog at <4.4. Native Renovate matching and Maven release filtering confirm 4.3 patch updates remain allowed, 4.4+ is rejected, and Apache driver updates and other catalogs are unchanged.","commit":1,"disposition":"fixed","key":"inline:4373220784"}],"input_identity":{},"outcome":"fixes","request_digest":"21f184f6994d8d48c44418b6365beb8900cabb490017e8f305ad1cf6714a7d2d","schema":2},"download_sha256":"bcd85eade6ba6d96e9f400f38340e82add7251423932af403acbb476ea2d7af8","frozen_sha":"6f2812a704be6b8337e73aa8a5abc2382de0a7c5","pr":135,"publication_eligible":false,"repo":"open-telemetry/semantic-conventions-conformance","request_digest":"21f184f6994d8d48c44418b6365beb8900cabb490017e8f305ad1cf6714a7d2d","request_id":"ff68c2b0ca50488897762fe1432213c2","run_attempt":1,"run_id":40253412892,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:bcd85eade6ba6d96e9f400f38340e82add7251423932af403acbb476ea2d7af8","verification":"verified","verification_run":{"attempt":1,"id":40254365466},"workflow_revision":"f9d2af9fce01ee319295abe00856608a264119f4"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5058960134,5059167363,5059167396,5059167425,5059167462,5059177103,5062268374,5062398185,5646321421],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nThe early-driver dependency needs a Renovate version bound to preserve coverage of the distinct driver 4.0\u20134.3 instrumentation path.\n\n<details open>\n<summary><strong>1 open issue</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Restrict Cassandra driver dependency updates to versions below 4.4](https://github.com/open-telemetry/semantic-conventions-conformance/pull/135#discussion_r4373220784) \u00b7 New\n</details>\n\n<sub>Review effort: Balanced</sub>","comment_id":null,"key":"review:5646321421","kind":"body","line":null,"path":null,"review_id":5646321421},{"body":"This pin is meant to retain the driver 4.0\u20134.3 instrumentation path, but the Gradle update rule in `.github/renovate.json5:45\u201349` allows minor upgrades and there is no Cassandra-specific version bound. A normal Renovate update to 4.4+ would silently turn this package into another run of the newer instrumentation line, losing the early-driver coverage. Add a file/package-scoped Renovate rule restricting `com.datastax.oss:java-driver-core` to versions below 4.4.","comment_commit_id":"6f2812a704be6b8337e73aa8a5abc2382de0a7c5","comment_id":4373220784,"key":"inline:4373220784","kind":"inline","line":6,"original_commit_id":"6f2812a704be6b8337e73aa8a5abc2382de0a7c5","original_line":6,"path":"scenarios/database/java/gradle/libs.versions.toml","review_commit_id":"6f2812a704be6b8337e73aa8a5abc2382de0a7c5","review_id":5646321421,"review_submitted_at":"2026-10-26T01:04:38Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"d390fba0c6983daf936202509b22aa814d6dddda3c4966d62ec97b26732c9cb2","id":4373220784,"parent":null,"updated_at":"2026-10-26T01:04:39Z"}],"thread_id":"PRRT_kwDOTuzK5c6wG6-j"}],"frozen_at":1792977295,"frozen_at_iso":"2026-10-26T01:14:55Z","frozen_sha":"6f2812a704be6b8337e73aa8a5abc2382de0a7c5","head_ref":"trask-add-cassandra-conformance","head_repo":"open-telemetry/semantic-conventions-conformance","head_repo_id":1324141285,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":40251830392},"loop_kind":"copilot_review","metadata":{"body":"Adds Java Cassandra conformance for the stable database semantic conventions. The database runner now starts a pinned Cassandra 5.0.9 container and runs simple queries, prepared statements, logged batches, and server-reported query errors against driver 3.11.5, driver 4.3.1, and Apache driver 4.19.3.\n\nThe Java agent covers all three driver lines. The published `opentelemetry-cassandra-4.4` library instrumentation runs against Apache driver 4.19.3. Earlier driver lines remain agent-only because OpenTelemetry does not publish standalone instrumentation for them.\n\nScenario contracts can now declare `allowed_metrics` alongside required `metrics`. Cassandra uses this to require `db.client.operation.duration` while accepting optional Java SDK and exporter self-metrics.\n","title":"Add Java Cassandra database conformance"},"mode":"publish","pr":135,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792976257,"generation":7,"max_pipelines":5,"phase":"5074dfd6c1c64f239a346a29f4fc8dd1","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/semantic-conventions-conformance","repo_id":1324141285,"request_id":"ff68c2b0ca50488897762fe1432213c2","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/f9d2af9fce01ee319295abe00856608a264119f4","workflow_revision":"f9d2af9fce01ee319295abe00856608a264119f4"},"run":{"attempt":1,"conclusion":"success","id":40253412892,"url":"https://github.com/trask/copilot-workflows/actions/runs/40253412892"},"schema":2,"seen_findings":["03ada8f0b3850e9b5f3245aa345ce024a46a307f92dc8f027dfb8661b4aa4ae0"],"seen_inline_findings":["fb84ef39189015d5a6b4d944eb5b9d53c94748ce64958e19487e7cced093812c"],"seen_missed_findings":[],"stage":"thread_effects","verification_run":{"attempt":1,"id":40254365466}}