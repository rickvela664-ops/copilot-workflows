est/java/io/opentelemetry/instrumentation/log4j/appender/v2_17/LogReplayOpenTelemetryAppenderTest.java"],"commit":"26ca132112f0bcd6490fad6a75b39b810f5bafc1","parent":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","patch_sha256":"8a3611460e8bbcaf5644048f9affba11a4d43264ccc7593501ade57e831b3d37","subject":"Preserve generic MapMessage semantics in replay snapshots","tree":"0db86aa1003cd2c7f3dfe426cd89a4edd08d6cf5"}],"cumulative_patch_sha256":"8a3611460e8bbcaf5644048f9affba11a4d43264ccc7593501ade57e831b3d37","finding_commits":{"inline:4244494175":"26ca132112f0bcd6490fad6a75b39b810f5bafc1","review:5486344877":"26ca132112f0bcd6490fad6a75b39b810f5bafc1"},"parent":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","patch_sha256":"8a3611460e8bbcaf5644048f9affba11a4d43264ccc7593501ade57e831b3d37","tree":"0db86aa1003cd2c7f3dfe426cd89a4edd08d6cf5"},"confirmed_at":1791781756,"effect":"push","generation":1,"request_id":"38cc199ebcef4af4978024bd8d639c5b","sha":"26ca132112f0bcd6490fad6a75b39b810f5bafc1"}],"reason":"fresh_Copilot_review_request_intent","report":{"artifact_id":11727292569,"candidate":{"bundle_sha256":"76f7cd683897b953180643a4f13941960b1ddb8a1cac6824ee86c9851bb977e4","changed":true,"changed_paths":["instrumentation/log4j/log4j-appender-2.17/library/src/main/java/io/opentelemetry/instrumentation/log4j/appender/v2_17/LogEventToReplay.java","instrumentation/log4j/log4j-appender-2.17/library/src/test/java/io/opentelemetry/instrumentation/log4j/appender/v2_17/LogReplayOpenTelemetryAppenderTest.java"],"commit":"26ca132112f0bcd6490fad6a75b39b810f5bafc1","commits":[{"changed_paths":["instrumentation/log4j/log4j-appender-2.17/library/src/main/java/io/opentelemetry/instrumentation/log4j/appender/v2_17/LogEventToReplay.java","instrumentation/log4j/log4j-appender-2.17/library/src/test/java/io/opentelemetry/instrumentation/log4j/appender/v2_17/LogReplayOpenTelemetryAppenderTest.java"],"commit":"26ca132112f0bcd6490fad6a75b39b810f5bafc1","parent":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","patch_sha256":"8a3611460e8bbcaf5644048f9affba11a4d43264ccc7593501ade57e831b3d37","subject":"Preserve generic MapMessage semantics in replay snapshots","tree":"0db86aa1003cd2c7f3dfe426cd89a4edd08d6cf5"}],"cumulative_patch_sha256":"8a3611460e8bbcaf5644048f9affba11a4d43264ccc7593501ade57e831b3d37","finding_commits":{"inline:4244494175":"26ca132112f0bcd6490fad6a75b39b810f5bafc1","review:5486344877":"26ca132112f0bcd6490fad6a75b39b810f5bafc1"},"parent":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","patch_sha256":"8a3611460e8bbcaf5644048f9affba11a4d43264ccc7593501ade57e831b3d37","tree":"0db86aa1003cd2c7f3dfe426cd89a4edd08d6cf5"},"dispositions":{"findings":[{"analysis":"The overview's generic MapMessage telemetry loss is the same concrete defect as the inline finding. LogEventToReplay now retains the MapMessage type with copied map data and captured message fields, so LogEventMapper still applies event-name, map-body, and structured-attribute rules. Regression cases cover buffered replay and installation during capture without changing the appender lock scope or formatting the original message twice.","commit":1,"disposition":"fixed","key":"review:5486344877"},{"analysis":"Confirmed: generic map messages previously became MessageCopy, which made LogEventMapper.captureMessage take the plain-message branch. All four regression cases failed with an absent MapEvent event name on the frozen implementation. A MapMessageCopy now preserves generic map semantics, defensively copies the data, and delegates captured format, parameters, formatted text, and throwable to the existing MessageCopy helper. The same four cases now pass and verify body selection, excluded attributes, non-string values, parameter copying, and single formatting during both buffered replay and installation completing during capture.","commit":1,"disposition":"fixed","key":"inline:4244494175"}],"input_identity":{},"outcome":"fixes","request_digest":"506dd5dc9d520a948b882759976359a15cc5aad184792a73a8df4f21ada92bf1","schema":2},"download_sha256":"4002063fdd2dfeee85d7e92b4a98b1e00d7a4589af9776a199dbc69acbe1c818","frozen_sha":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","pr":20523,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"506dd5dc9d520a948b882759976359a15cc5aad184792a73a8df4f21ada92bf1","request_id":"38cc199ebcef4af4978024bd8d639c5b","run_attempt":1,"run_id":38204855344,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:4002063fdd2dfeee85d7e92b4a98b1e00d7a4589af9776a199dbc69acbe1c818","verification":"verified","verification_run":{"attempt":1,"id":38206633492},"workflow_revision":"ad6a64e8dc14135373bf97b7702ff40449bb2704"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5486344877],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nSnapshot emission can lose telemetry semantics for generic Log4j `MapMessage` implementations.\n\n<details open>\n<summary><strong>1 open finding</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Preserve generic MapMessage semantics during replay snapshotting](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20523#discussion_r4244494175) \u00b7 New\n</details>\n\n<details>\n<summary><strong>What changed in this PR</strong></summary>\n\nReduces appender read-lock scope during pre-installation log capture.\n\n**Changes:**\n- Captures replay snapshots before locking.\n- Prints overflow warnings after unlocking.\n- Reuses Log4j snapshots when installation completes during capture.\n\n| File | Description |\r\n| ---- | ----------- |\r\n| Logback `OpenTelemetryAppender.java` | Narrows replay lock scope and defers warnings. |\r\n| Log4j `OpenTelemetryAppender.java` | Narrows lock scope and reuses captured events. |\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced\n\n---\n\n\ud83d\udca1 <a href=\"/open-telemetry/opentelemetry-java-instrumentation/new/copilot/fix-logback-log4j-emission?filename=.github/skills/code-review/SKILL.md\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Add a `code-review` agent skill</a> or configure MCP servers for context-aware, tailored reviews. <a href=\"https://docs.github.com/copilot/how-tos/use-copilot-agents/request-a-code-review/use-code-review?tool=webui#mcp-servers-and-agent-skills\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Learn more in the docs.</a>","comment_id":null,"key":"review:5486344877","kind":"body","line":null,"path":null,"review_id":5486344877},{"body":"[General] This transition path now changes telemetry for supported `MapMessage` implementations other than `StringMapMessage` and `StructuredDataMessage`. `LogEventToReplay` wraps those other map messages in `MessageCopy`, so `LogEventMapper` no longer recognizes them as a `MapMessage` and loses their event name, map body rules, and structured attributes when installation completes during capture. Please preserve generic `MapMessage` semantics in the snapshot (or emit the original event in this branch).","comment_commit_id":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","comment_id":4244494175,"key":"inline:4244494175","kind":"inline","line":522,"original_commit_id":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","original_line":522,"path":"instrumentation/log4j/log4j-appender-2.17/library/src/main/java/io/opentelemetry/instrumentation/log4j/appender/v2_17/OpenTelemetryAppender.java","review_commit_id":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","review_id":5486344877,"review_submitted_at":"2026-10-12T03:43:15Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"df512bc0a36d8f8e405058fd5cf9976fadccce2b67b7441b170f03b9d7d9474a","id":4244494175,"parent":null,"updated_at":"2026-10-12T03:43:15Z"}],"thread_id":"PRRT_kwDODJKVX86rUlPf"}],"frozen_at":1791780111,"frozen_at_iso":"2026-10-12T04:41:51Z","frozen_sha":"633b83f7e5d9bb80fc03fc628853bfe306846ac3","head_ref":"trask-appender-replay-lock-scope","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38204824705},"loop_kind":"copilot_review","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nBuilds on #20519 to further reduce the read-lock scope in the Logback and Log4j appenders. Replay-event capture runs on the original logging thread before locking, and the queue-overflow warning prints after unlocking.\n\nThe installation recheck, buffer-versus-emit decision, and once-only warning claim remain protected by the existing lock. If installation finishes during Log4j capture, emission reuses the snapshot to avoid formatting the original message again. The initialized fast path remains lock-free.\n\nPart of the locking audit in #20000.","title":"Reduce appender read-lock scope for replay capture"},"mode":"publish","pr":20523,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791780112,"generation":1,"max_pipelines":5,"phase":"813fad332abe4db88c619af833d27768","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"38cc199ebcef4af4978024bd8d639c5b","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/ad6a64e8dc14135373bf97b7702ff40449bb2704","workflow_revision":"ad6a64e8dc14135373bf97b7702ff40449bb2704"},"review_request":{"baseline_review_ids":[5486344877,5486723190],"baseline_run_ids":[38206713464,38206713570,38206713796,38206713797,38206714177],"claim":"1a85ed3a8f764b1a89a7fe958f80e040","confirmation":{"kind":"submitted_review","review_ids":[5486742939]},"owner":{"attempt":"1","run_id":"38206633492"},"recorded_at":1791781825,"sha":"26ca132112f0bcd6490fad6a75b39b810f5bafc1","status":"confirmed"},"run":{"attempt":1,"conclusion":"success","id":38204855344,"url":"https://github.com/trask/copilot-workflows/actions/runs/38204855344"},"schema":2,"seen_findings":["996537a11f5417a3d43300417b709d41685b900327605d4efe3437377d5a6658"],"seen_inline_findings":["8e74934077a71243fc9a2a1ffd6432bfac3d6e8c7b32e56a296d553d784f0419"],"seen_missed_findings":[],"stage":"waiting_review","verification_run":{"attempt":1,"id":38206633492}}