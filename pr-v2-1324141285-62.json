zen_at":1792082020,"frozen_at_iso":"2026-10-15T16:33:40Z","frozen_sha":"f6c389bd1312c7be1e4c121e1c368460a541be72","head_ref":"trask-http-rust-conformance","head_repo":"open-telemetry/semantic-conventions-conformance","head_repo_id":1324141285,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38770004071},"loop_kind":"pr_conflict_resolver","merge_base_sha":"5589743cf049a0488af1dc7af17fcf470e0db8fa","metadata":{"body":"Adds separate Rust conformance scenarios for an Actix Web server and an awc client, both instrumented with `opentelemetry-instrumentation-actix-web` 0.24.0. The server coverage includes HTTP metrics as well as spans.\n\nThe recorded coverage exposes three instrumentation findings:\n\n- awc client span names include the host, such as `GET 127.0.0.1`, instead of the required method-only name.\n- awc client spans omit the recommended `network.protocol.version` attribute.\n- Actix Web server spans set `error.type=\"404\"` for the 404 response but leave the span status unset.\n\nThe change also adds the shared Rust launcher, scenario lifecycle, OpenTelemetry SDK bootstrap, and HTTP contract support needed to build and run these scenarios in CI.\n\nIt also adds a repository-wide `.gitattributes`. Git now stores every text file with LF and checks it out with LF, so no language needs its own line-ending setting. Batch files are excluded, which leaves Gradle's `gradlew.bat` exactly as it is.\n\ncc @open-telemetry/rust-approvers\n","title":"Add Rust HTTP conformance scenarios for Actix Web and awc"},"mode":"publish","pr":62,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792082021,"generation":1,"max_pipelines":5,"phase":"457e47ac94454ffbb887bdd447f0341f","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/semantic-conventions-conformance","repo_id":1324141285,"request_id":"8980f336d1e840b28c92e357ab24b04e","schema":2,"source_private":false,"target