cd12c58671a9d24299115f8a89995ec23cb5a","parent":"63ea1d252d675cd4391a6601bd9936afe4d2d0fb","patch_sha256":"b3f5ef5193c92264311577689dcc694638b8feae2ee7b268884120c2d9b6f1ee","subject":"Test delayed Dubbo provider completion with installed agents","tree":"bd61d315e97a244f8064ca30ba0701510c47e430"}],"cumulative_patch_sha256":"b3f5ef5193c92264311577689dcc694638b8feae2ee7b268884120c2d9b6f1ee","finding_commits":{"inline:4308245509":"09bcd12c58671a9d24299115f8a89995ec23cb5a","review:5564354118":"09bcd12c58671a9d24299115f8a89995ec23cb5a"},"parent":"63ea1d252d675cd4391a6601bd9936afe4d2d0fb","patch_sha256":"b3f5ef5193c92264311577689dcc694638b8feae2ee7b268884120c2d9b6f1ee","tree":"bd61d315e97a244f8064ca30ba0701510c47e430"},"dispositions":{"findings":[{"analysis":"Added shared real-pipeline delayed-provider success and failure tests inherited by installed-agent and library suites, with a pinned Dubbo 2.7.0 installed-agent suite covering getResultFuture in addition to the existing whenCompleteWithContext runtimes. The single-threaded provider and queued barrier prove the invocation returned before pending-span assertions. Exact trace assertions, terminal server status and preview error.type, and duration counts of one verify completion behavior.","commit":1,"disposition":"fixed","key":"review:5564354118"},{"analysis":"AbstractDubboAsyncTest returns a deliberately pending CompletableFuture from an actual exported Dubbo service. After a second RPC traverses the same single provider thread, it asserts the server span remains recording and the response remains pending. Success and terminal IllegalStateException then complete exactly one server span and one duration observation, with ERROR status and preview error.type only on failure. DubboAgentAsyncTest runs with the installed agent on 2.7.0 (getResultFuture), 2.7.5 and 3.3.6 (whenCompleteWithContext), across legacy, preview, and duplicate modes.","commit":1,"disposition":"fixed","key":"inline:4308245509"}],"input_identity":{},"outcome":"fixes","request_digest":"93e3d33c04d61e05cacc39f3416da917984c46fa803fc489967441039f182e15","schema":2},"download_sha256":"2ddced46c581b84f59628d65dbabccbe3f2504ebd7f51792a355bdcbb12f6f2a","frozen_sha":"63ea1d252d675cd4391a6601bd9936afe4d2d0fb","pr":20675,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"93e3d33c04d61e05cacc39f3416da917984c46fa803fc489967441039f182e15","request_id":"d96a0b5539c8473b86006a2469687022","run_attempt":1,"run_id":39156469032,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:2ddced46c581b84f59628d65dbabccbe3f2504ebd7f51792a355bdcbb12f6f2a","verification":"verified","verification_run":{"attempt":1,"id":39159433039},"workflow_revision":"9c5098a3d18066ad5638649233da6db52445d29f"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5560893029,5564354118],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nDelayed Dubbo provider completion lacks installed-agent integration coverage across supported completion API shapes.\n\n<details open>\n<summary><strong>1 open issue</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Add installed-agent tests for delayed Dubbo provider span completion](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20675#discussion_r4308245509) \u00b7 New\n</details>\n\n<sub>Review effort: Balanced</sub>","comment_id":null,"key":"review:5564354118","kind":"body","line":null,"path":null,"review_id":5564354118},{"body":"[Testing] The delayed-provider cases in `TracingFilterTest` invoke the library filter with a hand-built `AsyncRpcResult`. The installed-agent suite inherits `AbstractDubboTest`, whose `$invokeAsync` calls the synchronous `HelloServiceImpl.hello`, so it does not exercise completion after the provider returns. Add shared delayed-provider success and failure tests with the installed agent, using supported versions that exercise both `whenCompleteWithContext` and `getResultFuture`. Assert that the server span stays open until completion, ends once, and records the terminal failure status and preview `error.type`. This covers the new lifecycle through Dubbo's actual provider pipeline and injected helpers.","comment_commit_id":"63ea1d252d675cd4391a6601bd9936afe4d2d0fb","comment_id":4308245509,"key":"inline:4308245509","kind":"inline","line":79,"original_commit_id":"63ea1d252d675cd4391a6601bd9936afe4d2d0fb","original_line":79,"path":"instrumentation/apache-dubbo-2.7/library-autoconfigure/src/main/java/io/opentelemetry/instrumentation/apachedubbo/v2_7/TracingFilter.java","review_commit_id":"63ea1d252d675cd4391a6601bd9936afe4d2d0fb","review_id":5564354118,"review_submitted_at":"2026-10-18T18:47:26Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"e3d53b7412676681a6b54979435900d3edea5ecec618f997c302af3443d211ae","id":4308245509,"parent":null,"updated_at":"2026-10-18T18:47:26Z"}],"thread_id":"PRRT_kwDODJKVX86ttWRr"}],"frozen_at":1792349712,"frozen_at_iso":"2026-10-18T18:55:12Z","frozen_sha":"63ea1d252d675cd4391a6601bd9936afe4d2d0fb","head_ref":"copilot/fix-grpc-error-type-gaps","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":39155171937},"loop_kind":"copilot_review","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nAdds bounded `error.type` to new and duplicate RPC telemetry for terminal failures while preserving legacy output.\n\n- **gRPC:** Classify terminal status codes by client/server role; omit server cancellations.\n- **Thrift:** Classify serialized failures as `_OTHER` when no throwable survives, retaining more-specific classifications otherwise.\n- **Metrics:** Include `error.type` in advice for new RPC duration histograms only.\n- **Dubbo:** End provider spans on asynchronous completion across supported 2.7 API shapes.","title":"Capture terminal error.type for new RPC telemetry"},"mode":"publish","pr":20675,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792348797,"generation":3,"max_pipelines":5,"phase":"188f1826773e4bbda2afce966cafed70","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"d96a0b5539c8473b86006a2469687022","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/9c5098a3d18066ad5638649233da6db52445d29f","workflow_revision":"9c5098a3d18066ad5638649233da6db52445d29f"},"run":{"attempt":1,"conclusion":"success","id":39156469032,"url":"https://github.com/trask/copilot-workflows/actions/runs/39156469032"},"schema":2,"seen_findings":["066e602e94a9c3ba59139a8c43918fc18ddaccb16b63d48bd0efa80ad41c47f8"],"seen_inline_findings":["7df788f44396a1b95c2cbc2ae953e199103d0f7f253781f1ddf77282de98f2d6"],"seen_missed_findings":[],"stage":"published","verification_run":{"attempt":1,"id":39159433039}}