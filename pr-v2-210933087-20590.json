changed":false,"changed_paths":[],"commit":"4e60d379c4a9bc355537b966b54053961cb85a01","commits":[],"cumulative_patch_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","finding_commits":{},"parent":"4e60d379c4a9bc355537b966b54053961cb85a01","patch_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","tree":"6eec6ccc346df3c8bfe0ac4214371a7516a7bab0"},"dispositions":{"comments":[{"body":"[P1] [General] Do not interpret a fat JAR's application version as the Ktor version\n\nWhen Ktor is shaded into an application JAR, `Application::class.java.package.implementationVersion` can be the application's `Implementation-Version`, not Ktor's. For example, Ktor 3.4.3 packaged in `application-all.jar` with `Implementation-Version: 1.0.0` is classified as requiring `EmptyInterceptor`, bypassing the dispatcher fix. I reproduced this with the frozen library artifacts and the new regression scenario: five distinct traceparents all returned the first request's trace ID; the same Ktor classes passed with their original manifest or no version metadata. Validate that the metadata belongs to Ktor, or detect the relevant runtime capability, and route application-owned metadata through the unknown-version fallback. Include an application-version fat-JAR regression case.","line":33,"path":"instrumentation/ktor/ktor-common-2.0/library/src/main/kotlin/io/opentelemetry/instrumentation/ktor/common/v2_0/internal/KtorServerTelemetryUtil.kt","side":"RIGHT"}],"input_identity":{"pr_diff_sha256":"167e92eaf400634798502560a424782b76a59c2ff4d8cf148272fa7cf10574b7"},"outcome":"comments","request_digest":"266a5af6c943d79956f92da8ac52d8064f97e9a994a7d295d2b88ea819ae5388","schema":2},"download_sha256":"b525f2a7669ed5cc429fc6ad4a6ba92a3fb506a916d78156bf70ba0a75124ec6","frozen_sha":"4e60d379c4a9bc355537b966b54053961cb85a01","pr":20590,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"266a5af6c943d79956f92da8a