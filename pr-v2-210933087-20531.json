":"b5d237ab5154d875494af9e2f3c4fa3c0faa6124","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nRemove bundled support for the contrib links-based and declarative rule-based routing samplers from the Java agent and Spring Boot starter. Standard SDK sampler configuration remains supported.\n\n- **Changes**\n  - Remove the sampler dependencies, warning/rejection customizers, and preview-only tests.\n  - Retain flat and declarative coverage for ordinary sampler configuration.\n\n- **Migration**\n  - The links-based sampler has no replacement.\n  - For compatible routing policies, the SDK incubator\u2019s declarative `composite/development` `rule_based` sampler may be used. Its ordered rules use case-sensitive exact/wildcard matching; unmatched spans need an explicit fallback rule. It does not directly preserve contrib regex, action, or fallback behavior.\n\n  ```yaml\n  file_format: \"1.1\"\n  tracer_provider:\n    sampler:\n      composite/development:\n        rule_based:\n          rules:\n            - attribute_patterns:\n                key: url.path\n                included: [\"/actuator*\"]\n              sampler:\n                always_off:\n            - sampler:\n                always_on:\n  ```","title":"Remove bundled legacy contrib sampler support"},"mode":"publish","pr":20531,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791837731,"generation":2,"max_pipelines":5,"phase":"6b94724a03df4d8dbe845bb6843a2954","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"f5fbe36ad47c40858f7ac27dc622ab7d","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/bb68514826ed27b756023e196d2f92f7e88fa58a","workflow_revision":"bb