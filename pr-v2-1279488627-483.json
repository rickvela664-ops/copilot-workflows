ulative_patch_sha256":"2310f299fd3fee94de9ed4e84a96053e0a234138ea0e6e173fc601d94e4fff70","finding_commits":{"inline:4304102990":"969520104cae7a1794a4d13b7c77639ad2c52183","inline:4304103031":"c50dfa40ac887815f5665fb12a9902bc86ee374a","review:5559592811":"c50dfa40ac887815f5665fb12a9902bc86ee374a"},"parent":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","patch_sha256":"2310f299fd3fee94de9ed4e84a96053e0a234138ea0e6e173fc601d94e4fff70","tree":"64e9284299bf9ea54d96c71e5f7ae384f3246227"},"confirmed_at":1792285314,"effect":"push","generation":1,"request_id":"840150f60a874e5abbe75708646a45e1","sha":"c50dfa40ac887815f5665fb12a9902bc86ee374a"}],"reason":"pending_fresh_trusted_personal_acceptance","report":{"artifact_id":12119912796,"candidate":{"bundle_sha256":"bf2f628805b07bc91bda5e66384e8fa13e73b4c01c6b714cbd8c7588b9e9046b","changed":true,"changed_paths":[".github/scripts/pull-request-dashboard/copilot_review_findings.py",".github/scripts/pull-request-dashboard/github_cli.py",".github/scripts/pull-request-dashboard/test_copilot_review_findings.py","pull-request-dashboard/README.md"],"commit":"c50dfa40ac887815f5665fb12a9902bc86ee374a","commits":[{"changed_paths":[".github/scripts/pull-request-dashboard/copilot_review_findings.py",".github/scripts/pull-request-dashboard/test_copilot_review_findings.py","pull-request-dashboard/README.md"],"commit":"969520104cae7a1794a4d13b7c77639ad2c52183","parent":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","patch_sha256":"16c3f7e1c2d358ceb2438cfd06bdc9fa4d8ce6f4a6e24b0618511ea921846733","subject":"Preserve Markdown code in promoted Copilot findings","tree":"68d4921a262a2e5958186a01f94a3c6469bf47d0"},{"changed_paths":[".github/scripts/pull-request-dashboard/github_cli.py",".github/scripts/pull-request-dashboard/test_copilot_review_findings.py"],"commit":"c50dfa40ac887815f5665fb12a9902bc86ee374a","parent":"969520104cae7a1794a4d13b7c77639ad2c52183","patch_sha256":"bf50806d7dbaa7e0a000d679d16eff57592e15f87870c818156bc0f3491ce904","subject":"Request bot types for review-thread comment authors","tree":"64e9284299bf9ea54d96c71e5f7ae384f3246227"}],"cumulative_patch_sha256":"2310f299fd3fee94de9ed4e84a96053e0a234138ea0e6e173fc601d94e4fff70","finding_commits":{"inline:4304102990":"969520104cae7a1794a4d13b7c77639ad2c52183","inline:4304103031":"c50dfa40ac887815f5665fb12a9902bc86ee374a","review:5559592811":"c50dfa40ac887815f5665fb12a9902bc86ee374a"},"parent":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","patch_sha256":"2310f299fd3fee94de9ed4e84a96053e0a234138ea0e6e173fc601d94e4fff70","tree":"64e9284299bf9ea54d96c71e5f7ae384f3246227"},"dispositions":{"findings":[{"analysis":"The overview summarizes the same two actionable inline findings, with no additional independent issue. Commit 1 fixes structural HTML parsing of Markdown code, and commit 2 completes the overview's requested corrections by requesting Bot author types in both review-thread comment queries. The final candidate preserves finding text, suppresses repeated promotion, and clears the gate when the fetched copy is resolved.","commit":2,"disposition":"fixed","key":"review:5559592811"},{"analysis":"The frozen parser treated literal details and summary tags in Markdown code as structural HTML, reproducing both unclosed-details errors and truncated explanations. The parser now masks fenced blocks and exact-delimiter code spans without changing character or newline offsets, while extracting original source slices. Title markup removal also preserves tags inside code spans. Regression cases cover opening and closing tags, multi-backtick and multiline spans, backtick and tilde fences, original copied text, and the evaluation gate. Malformed structural findings still fail explicitly.","commit":1,"disposition":"fixed","key":"inline:4304102990"},{"analysis":"Both REVIEW_THREADS_QUERY and REVIEW_THREAD_COMMENTS_QUERY now request author.__typename alongside login. Existing normalize_actor handling therefore canonicalizes fetched unsuffixed Bot logins before the unchanged trusted-dashboard-bot check. A fetched-and-normalized initial/paginated comment regression verifies both query selections, suppression of reposting, and clearing the clean-review gate after resolution. Human and untyped unsuffixed dashboard logins remain unable to spoof a promoted finding.","commit":2,"disposition":"fixed","key":"inline:4304103031"}],"input_identity":{},"outcome":"fixes","request_digest":"ecce28a7cee04d730d7de950606c3b716430826fcd7eeedd6073cb01582b97b5","schema":2},"download_sha256":"32d5840ae48aa89baa4c75c596f8a313c117d4271d32267c08273ba2e3e7afda","frozen_sha":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","pr":483,"publication_eligible":false,"repo":"open-telemetry/shared-workflows","request_digest":"ecce28a7cee04d730d7de950606c3b716430826fcd7eeedd6073cb01582b97b5","request_id":"840150f60a874e5abbe75708646a45e1","run_attempt":1,"run_id":39083902638,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:32d5840ae48aa89baa4c75c596f8a313c117d4271d32267c08273ba2e3e7afda","verification":"verified","verification_run":{"attempt":1,"id":39084904172},"workflow_revision":"d79f856c6106f7aa83a1fe416bbbac0f61942310"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5559592811],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nBot identity handling can defeat deduplication, and Markdown parsing can truncate findings or fail PR evaluation.\n\n<details open>\n<summary><strong>2 open issues</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Ignore structural tags inside Markdown code content](https://github.com/open-telemetry/shared-workflows/pull/483#discussion_r4304102990) \u00b7 New\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\" alt=\"Medium severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Request author type to normalize bot review-thread authors](https://github.com/open-telemetry/shared-workflows/pull/483#discussion_r4304103031) \u00b7 New\n</details>\n\n<details>\n<summary><strong>What changed in this PR</strong></summary>\n\nPromotes summary-only Copilot findings into dashboard-managed review threads so authors can discuss and resolve them.\n\n**Changes:**\n- Extracts current-head findings with attribution and deduplication markers.\n- Adds inline/file-level delivery and clean-review gate integration.\n- Documents the workflow and adds regression coverage.\n\n| File | Description |\r\n| ---- | ----------- |\r\n| pull-request-dashboard/\u200bREADME.md | Documents promotion and resolution behavior. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200btest_state.py | Tests promotion-intent persistence. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200btest_github_cli.py | Tests comment posting and retry controls. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200btest_delivery.py | Tests delivery integration. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200btest_copilot_review_findings.py | Covers extraction, promotion, and gating. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bstate.py | Serializes promotion intent. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bpull_request_evaluation.py | Computes promotion intent and source links. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bpull_request_activity.py | Attributes promoted comments to Copilot. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bgithub_cli.py | Adds diff mapping and comment creation. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bdiscussion_lifecycle.py | Applies Copilot lifecycle rules to copies. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bdelivery.py | Invokes finding delivery. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bdashboard_status.py | Recognizes promotion markers. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bdashboard_contracts.py | Adds promotion-intent field. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bcopilot_review.py | Includes summary findings in gate status. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bcopilot_review_findings.py | Parses and deduplicates summary findings. |\r\n| .github/\u200bscripts/\u200bpull-request-dashboard/\u200bcopilot_review_delivery.py | Posts eligible findings after fresh checks. |\n</details>\n\n<sub>Review effort: Balanced</sub>","comment_id":null,"key":"review:5559592811","kind":"body","line":null,"path":null,"review_id":5559592811},{"body":"Passing raw Markdown to `HTMLParser` treats tags inside code spans and fenced examples as structural markup. A finding containing `Close the <details> element` with the tag in a code span raises the unclosed-details error; an inline-code `</details>` truncates the copied explanation. Extraction also runs during fact computation, so valid review text can fail the entire PR evaluation. Ignore code spans and fenced blocks when recognizing structural tags, while preserving source offsets and the original finding text. Add regression cases for both opening and closing tags.","comment_commit_id":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","comment_id":4304102990,"key":"inline:4304102990","kind":"inline","line":102,"original_commit_id":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","original_line":102,"path":".github/scripts/pull-request-dashboard/copilot_review_findings.py","review_commit_id":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","review_id":5559592811,"review_submitted_at":"2026-10-17T19:13:20Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"e19b979ff21cf74bc198c8581463ac2de8e928eacdfbbdf988cf649bdda6e08e","id":4304102990,"parent":null,"updated_at":"2026-10-17T19:13:20Z"}],"thread_id":"PRRT_kwDOTENyc86tjfOu"},{"body":"The review-thread GraphQL queries fetch only `author.login`, so an unsuffixed bot login such as `opentelemetry-pr-dashboard` reaches this check unchanged. `normalize_actor()` only appends `[bot]` when the response includes the Bot type. Existing copies are therefore not recognized: refreshes can repost them, and resolving a copy does not clear the summary finding. Request `author.__typename` in both the initial and paginated thread-comment queries in `github_cli.py`, and add a regression test using a fetched and normalized bot author. Keep the trusted-bot check rather than accepting an untyped, unsuffixed login.","comment_commit_id":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","comment_id":4304103031,"key":"inline:4304103031","kind":"inline","line":36,"original_commit_id":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","original_line":36,"path":".github/scripts/pull-request-dashboard/dashboard_status.py","review_commit_id":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","review_id":5559592811,"review_submitted_at":"2026-10-17T19:13:20Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"794278a7ddf48900b83ca5bf19f3ce7b0f034048f1fb7332005d3d96c3bddc46","id":4304103031,"parent":null,"updated_at":"2026-10-17T19:13:20Z"}],"thread_id":"PRRT_kwDOTENyc86tjfPO"}],"frozen_at":1792284269,"frozen_at_iso":"2026-10-18T00:44:29Z","frozen_sha":"beccb1338ea23d4723cb0e706af7f1d2c7470c3e","head_ref":"trask-copilot-review-findings","head_repo":"open-telemetry/shared-workflows","head_repo_id":1279488627,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":39083869452},"loop_kind":"copilot_review","metadata":{"body":"Promote Copilot's summary-only \"previously missed\" findings into review threads posted by the dashboard app, so authors can discuss or reject them and resolve the conversation.\n\nCopies preserve Copilot's wording, severity, and source link. Findings count against the clean-review gate before and after promotion; resolving a copy clears the finding without reposting it on the same commit.\n\nOnly findings from the latest Copilot overview of the current head are copied. When the reported line is unavailable in the diff, use a file-level review comment instead.","title":"Promote summary-only Copilot findings to review threads"},"mode":"publish","pr":483,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792284271,"generation":1,"max_pipelines":5,"phase":"67834b6d666f49d2b9a936cb5cd26e95","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/shared-workflows","repo_id":1279488627,"request_id":"840150f60a874e5abbe75708646a45e1","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/d79f856c6106f7aa83a1fe416bbbac0f61942310","workflow_revision":"d79f856c6106f7aa83a1fe416bbbac0f61942310"},"run":{"attempt":1,"conclusion":"success","id":39083902638,"url":"