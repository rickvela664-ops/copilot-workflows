ttpServer.create` owns the socket immediately, probing with `findOpenPort()` introduces an avoidable check-then-bind race; the existing `getAddress().getPort()` call already retrieves the OS-assigned port.","comment_commit_id":"e00090f6018c193099924395c0f5714525378698","comment_id":4239338031,"key":"inline:4239338031","kind":"inline","line":57,"original_commit_id":"e00090f6018c193099924395c0f5714525378698","original_line":57,"path":"instrumentation/xxl-job/xxl-job-2.3.0/javaagent/src/xxlJob33Test/java/io/opentelemetry/javaagent/instrumentation/xxljob/v3_3_0/XxlJobTest.java","review_commit_id":"e00090f6018c193099924395c0f5714525378698","review_id":5480939251,"review_submitted_at":"2026-10-10T21:54:27Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"b2e9d7b7902dc1cb30297e6da6f386ef3396e811ad13eee86bcd5ab9940753b2","id":4239338031,"parent":null,"updated_at":"2026-10-10T21:54:27Z"}],"thread_id":"PRRT_kwDODJKVX86rIF79"}],"frozen_at":1791742311,"frozen_at_iso":"2026-10-11T18:11:51Z","frozen_sha":"e00090f6018c193099924395c0f5714525378698","head_ref":"otelbot/update-latest-dep-versions","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38162783434},"loop_kind":"copilot_review","metadata":{"body":"Auto-generated update of pinned latest dependency versions used by `testLatestDeps` builds.\n\nAlso updates the xxl-job integration test fixture for 3.5.0's relocated trigger request and executor startup requirements, while preserving coverage of the 3.3.0 baseline.","title":"Update pinned latest dep versions"},"mode":"publish","pr":20495,"pr_author_id":212412449,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791742313,"generation":2,"max_pipelines":5,"phase":"393d53f089fd4997bfcb