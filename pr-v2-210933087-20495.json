javaagent/instrumentation/xxljob/v3_3_0/XxlJobTest.java"],"commit":"4c1291d54e493f7f7a8a387dd220e1247a353d5b","parent":"e00090f6018c193099924395c0f5714525378698","patch_sha256":"55948698ea0e37774405ad9cde29d6977ca44ca21d2cd093a270754f7d212e0d","subject":"Bind xxl-job mock admin server directly to an ephemeral port","tree":"de9c982b5e3a6504e36d9131202d9d0e10ec4c46"}],"cumulative_patch_sha256":"55948698ea0e37774405ad9cde29d6977ca44ca21d2cd093a270754f7d212e0d","finding_commits":{"inline:4239338031":"4c1291d54e493f7f7a8a387dd220e1247a353d5b","review:5480939251":"4c1291d54e493f7f7a8a387dd220e1247a353d5b"},"parent":"e00090f6018c193099924395c0f5714525378698","patch_sha256":"55948698ea0e37774405ad9cde29d6977ca44ca21d2cd093a270754f7d212e0d","tree":"de9c982b5e3a6504e36d9131202d9d0e10ec4c46"},"dispositions":{"findings":[{"analysis":"The overview summarizes the same check-then-bind race as inline:4239338031. Commit 1 makes the mock admin HttpServer bind localhost port 0 immediately; getAddress().getPort() supplies its assigned endpoint without a separate probe.","commit":1,"disposition":"fixed","key":"review:5480939251"},{"analysis":"HttpServer.create now receives new InetSocketAddress(\"localhost\", 0), retaining the OS-assigned socket immediately. The existing getAddress().getPort() supplies the admin URL. The separately started executor retains findOpenPort(). Baseline normal and experimental installed-agent integration suites pass, as does an exact-setup runtime check with 16 simultaneously bound servers. Latest-dependency tests could not execute due to unrelated configuration/toolchain failures recorded in diagnostics.","commit":1,"disposition":"fixed","key":"inline:4239338031"}],"input_identity":{},"outcome":"fixes","request_digest":"b54eddb7e6027280d01475fb8e101362d030f70f5fff4f8190f688cb5109c772","schema":2},"download_sha256":"de1d289c3bbcfd11a6ae5d4fb8aff16e013dbb2fcb71c97619f5d48741c4622e","frozen_sha":"e00090f6018c193099924395c0f5714525378698","pr":20495,"publication