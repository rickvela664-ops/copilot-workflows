inline:4263317362":"a54fe0656aa1006b9d9dea00af05bd8b5dffc885","inline:4263317436":"a54fe0656aa1006b9d9dea00af05bd8b5dffc885","inline:4263317492":"18293d3406e91e233072aabff07c25e22bc3a7fb"},"parent":"ddb839ed03b8ee23750f11797555f7513ee222b5","patch_sha256":"7702360db466b54c8b76146a2047f684275b81682b1b2c2645b39262975ed91d","tree":"3267259527011d8379547e1b3f5c8e96aa55a949"},"dispositions":{"findings":[{"analysis":"Mongo37Singletons and its version37Test now use io.opentelemetry.mongo-3.1. Removed the obsolete mongo-3.7 alias from TelemetryParser and updated the existing parameterized test to reject it while retaining acceptance of mongo-3.1. The shared filter applies consistently to spans, metrics and events.","commit":1,"disposition":"fixed","key":"inline:4263317362"},{"analysis":"The ratpack-1.4 Java agent HTTP client and its version17Test now use io.opentelemetry.ratpack-1.4. Removed the obsolete ratpack-1.7 alias from TelemetryParser and updated its existing parameterized test. Library instrumentation using its own ratpack-1.7 module scope remains accepted by the unchanged exact-scope equality check.","commit":1,"disposition":"fixed","key":"inline:4263317436"},{"analysis":"The applicable Java style instructions prefer stateless attributes getters constructed at registration. Restored a static initializer with one local JaxrsCodeAttributesGetter shared by both extractors, removing the redundant field while preserving the finalized scope, controller enablement and instrumenter behavior. The complete JAX-RS module test suite passed.","commit":2,"disposition":"fixed","key":"inline:4263317492"}],"input_identity":{},"outcome":"fixes","request_digest":"00bd8816d6fd3e211704375e95b4d994925854120a3131f9eac50f0e4eec15de","schema":2},"download_sha256":"a112d95e9060fa0e79ffc06524ef5e3f62a75dfb06f913eed245b7cb40472a48","frozen_sha":"ddb839ed03b8ee23750f11797555f7513ee222b5","pr":20584,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","reques