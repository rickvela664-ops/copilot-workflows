ine:4242827065":"f4278c80c7592d7940b1e941229bbc7641cce1f9"},"parent":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","patch_sha256":"cc81a9edaa5687f7533d6f4c1a2784511186f18de0ac57637aadd7cbcd193aa6","tree":"4462ce1e915d2c6fc805f037fc80697bd894e2f5"},"confirmed_at":1791777173,"effect":"push","generation":1,"request_id":"c3ac359b970e4e8a9b14940182a7b95a","sha":"f4278c80c7592d7940b1e941229bbc7641cce1f9"}],"reason":"pending_fresh_trusted_personal_acceptance","report":{"artifact_id":11725461686,"candidate":{"bundle_sha256":"207870c920cacd8f05ddecf833ea0cad86e4993f26dec3c2518d9c4f232744e3","changed":true,"changed_paths":["instrumentation/rocketmq/rocketmq-client-4.8/library/src/test/java/io/opentelemetry/instrumentation/rocketmqclient/v4_8/RocketMqProducerWrapperTest.java"],"commit":"f4278c80c7592d7940b1e941229bbc7641cce1f9","commits":[{"changed_paths":["instrumentation/rocketmq/rocketmq-client-4.8/library/src/test/java/io/opentelemetry/instrumentation/rocketmqclient/v4_8/RocketMqProducerWrapperTest.java"],"commit":"f4278c80c7592d7940b1e941229bbc7641cce1f9","parent":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","patch_sha256":"cc81a9edaa5687f7533d6f4c1a2784511186f18de0ac57637aadd7cbcd193aa6","subject":"Remove redundant RocketMQ batch count assertion cast","tree":"4462ce1e915d2c6fc805f037fc80697bd894e2f5"}],"cumulative_patch_sha256":"cc81a9edaa5687f7533d6f4c1a2784511186f18de0ac57637aadd7cbcd193aa6","finding_commits":{"inline:4242827065":"f4278c80c7592d7940b1e941229bbc7641cce1f9"},"parent":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","patch_sha256":"cc81a9edaa5687f7533d6f4c1a2784511186f18de0ac57637aadd7cbcd193aa6","tree":"4462ce1e915d2c6fc805f037fc80697bd894e2f5"},"dispositions":{"findings":[{"analysis":"The review overview repeats the inline null-pointer claim, but RocketMqProducerWrapper.java:97 calls setWaitStoreMsgOK before instrumenter.start at lines 111-114. RocketMQ Message.setWaitStoreMsgOK calls putProperty, which initializes a missing property map. The unmodified frozen-head wrapper suite passed all 26 tests, including pre-encoding propagation and messages with initially null properties. The overview has no independent defect; its redundant-cast item is resolved by the separate inline finding in candidate commit 1.","commit":null,"disposition":"not_warranted","key":"review:5484544596"},{"analysis":"The synthetic envelope already has initialized properties when propagation runs: RocketMqProducerWrapper.java:95-97 constructs it and invokes setWaitStoreMsgOK; RocketMQ 4.8.0 Message.java:160-161 calls putProperty, whose lines 67-72 allocate a HashMap when properties is null. This precedes instrumenter.start at wrapper lines 111-114 and MapSetter.set at lines 23-27. Existing all-overload propagation and uninitialized-message tests passed on the unchanged frozen head and again after the assertion-only cleanup. No extra property initialization or production change is warranted.","commit":null,"disposition":"not_warranted","key":"inline:4242827044"},{"analysis":"Removed the redundant (long) cast from the batch-count assertion at RocketMqProducerWrapperTest.java:497. The equalTo(AttributeKey<Long>, int) overload preserves the assertion, matches the repository Java test instructions, and compiled successfully. All 26 focused wrapper tests, module Spotless checks and test Checkstyle checks passed.","commit":1,"disposition":"fixed","key":"inline:4242827065"}],"input_identity":{},"outcome":"fixes","request_digest":"58da86004b1b8d90ada15ab0d582eb066381bb5775c0cfadc9c5452a49fceb46","schema":2},"download_sha256":"65c9c39c7bea0c930abf4b874a7a3db739d3f1718db6e1ffb3954a6af7c95664","frozen_sha":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","pr":20479,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"58da86004b1b8d90ada15ab0d582eb066381bb5775c0cfadc9c5452a49fceb46","request_id":"c3ac359b970e4e8a9b14940182a7b95a","run_attempt":1,"run_id":38199873447,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:65c9c39c7bea0c930abf4b874a7a3db739d3f1718db6e1ffb3954a6af7c95664","verification":"verified","verification_run":{"attempt":1,"id":38201327424},"workflow_revision":"ad6a64e8dc14135373bf97b7702ff40449bb2704"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5484544596],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nThe synthetic batch envelope lacks a property map, allowing propagation to fail with a null-pointer exception before delegation.\n\n<details open>\n<summary><strong>2 open findings</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.png\" alt=\"High severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Initialize synthetic envelope properties before starting instrumenter](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20479#discussion_r4242827044) \u00b7 New\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.png\" alt=\"Low severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Remove redundant cast when passing count to equalTo](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20479#discussion_r4242827065) \u00b7 New\n</details>\n\n<details>\n<summary><strong>What changed in this PR</strong></summary>\n\nAdds a RocketMQ producer wrapper that injects context before batch encoding, restoring propagation for newer clients.\n\n**Changes:**\n- Adds `RocketMqTelemetry.wrap(DefaultMQProducer)` and deprecates hook-only producer instrumentation.\n- Adds batch propagation, lifecycle, failure, and integration coverage.\n- Updates javaagent wiring and usage documentation.\n\n| File | Description |\r\n| ---- | ----------- |\r\n| `CHANGELOG.md` | Records the API deprecation and replacement. |\r\n| `.../\u200btesting/\u200b.../\u200bAbstractRocketMqClientTest.java` | Routes sends through the configured producer wrapper. |\r\n| `.../\u200blibrary/\u200b.../\u200bRocketMqProducerWrapperTest.java` | Tests wrapper behavior and batch propagation. |\r\n| `.../\u200blibrary/\u200b.../\u200bRocketMqClientTest.java` | Configures library tests with the wrapper. |\r\n| `.../\u200blibrary/\u200b.../\u200bTracingSendMessageHookImpl.java` | Coordinates hooks with wrapper-owned send state. |\r\n| `.../\u200blibrary/\u200b.../\u200bRocketMqTelemetry.java` | Exposes the wrapper API and deprecates the send hook API. |\r\n| `.../\u200blibrary/\u200b.../\u200bRocketMqProducerWrapper.java` | Implements producer delegation and pre-encoding propagation. |\r\n| `.../\u200blibrary/\u200b.../\u200bRocketMqProducerAttributeGetter.java` | Reports wrapper batch message counts. |\r\n| `.../\u200blibrary/\u200bREADME.md` | Documents wrapper-based usage. |\r\n| `.../\u200bjavaagent/\u200b.../\u200bRocketMqClientTest.java` | Adapts javaagent tests to the shared producer contract. |\r\n| `.../\u200bjavaagent/\u200b.../\u200bRocketMqSingletons.java` | Uses the helper-created send hook. |\r\n| `.../\u200bjavaagent/\u200b.../\u200bRocketMqBatchSendHelper.java` | Constructs single-message hook instrumentation directly. |\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced\n\n---\n\n\ud83d\udca1 <a href=\"/open-telemetry/opentelemetry-java-instrumentation/new/main?filename=.github/skills/code-review/SKILL.md\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Add a `code-review` agent skill</a> or configure MCP servers for context-aware, tailored reviews. <a href=\"https://docs.github.com/copilot/how-tos/use-copilot-agents/request-a-code-review/use-code-review?tool=webui#mcp-servers-and-agent-skills\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Learn more in the docs.</a>","comment_id":null,"key":"review:5484544596","kind":"body","line":null,"path":null,"review_id":5484544596},{"body":"[General] `createProducerInstrumenter` injects through `MapSetter` during `instrumenter.start(...)`, and that setter calls `envelope.getProperties().put(...)`. A default RocketMQ `Message` has no initialized property map, so an instrumented collection send can throw before reaching the producer. Initialize this synthetic envelope's properties (or otherwise prevent propagation into the envelope) before starting the instrumenter.","comment_commit_id":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","comment_id":4242827044,"key":"inline:4242827044","kind":"inline","line":95,"original_commit_id":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","original_line":95,"path":"instrumentation/rocketmq/rocketmq-client-4.8/library/src/main/java/io/opentelemetry/instrumentation/rocketmqclient/v4_8/RocketMqProducerWrapper.java","review_commit_id":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","review_id":5484544596,"review_submitted_at":"2026-10-11T19:08:22Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"3522b82c85441853a3ca27bd8bd6da3b6ea4603b60c68b581ed4d60900d65773","id":4242827044,"parent":null,"updated_at":"2026-10-11T19:08:22Z"}],"thread_id":"PRRT_kwDODJKVX86rQklH"},{"body":"[Testing] `equalTo(AttributeKey<Long>, int)` already supports this value, so the explicit cast is redundant; pass `count` directly.","comment_commit_id":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","comment_id":4242827065,"key":"inline:4242827065","kind":"inline","line":497,"original_commit_id":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","original_line":497,"path":"instrumentation/rocketmq/rocketmq-client-4.8/library/src/test/java/io/opentelemetry/instrumentation/rocketmqclient/v4_8/RocketMqProducerWrapperTest.java","review_commit_id":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","review_id":5484544596,"review_submitted_at":"2026-10-11T19:08:22Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"bb011fc5c6a39a3bff9699a8090ba4111e713dac5cd64d25aa10d358675b862e","id":4242827065,"parent":null,"updated_at":"2026-10-11T19:08:22Z"}],"thread_id":"PRRT_kwDODJKVX86rQklV"}],"frozen_at":1791775647,"frozen_at_iso":"2026-10-12T03:27:27Z","frozen_sha":"cf2536b1b485909a795dbb6ca36b3a51df0d5c4c","head_ref":"copilot/fix-context-propagation-rocketmq","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38199801085},"loop_kind":"copilot_review","metadata":{"body":"<!--\r\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\r\na deprecation or breaking change.\r\n-->\r\n\r\nFix RocketMQ library batch propagation by injecting context before the client encodes the messages, rather than re-encoding them in a send hook.\r\n\r\nConfigure a `DefaultMQProducer`, then wrap it once for both single-message and batch sends:\r\n\r\n```java\r\nMQProducer producer = telemetry.wrap(configuredProducer);\r\nproducer.send(message);\r\nproducer.send(messages);\r\n```\r\n\r\nDeprecate `RocketMqTelemetry.createSendMessageHook()` in favor of `wrap(DefaultMQProducer)`. The old hook stays functional, but hook-only integrations must adopt wrapping to get the batch propagation fix.\r\n\r\nUse collection-based `send` overloads for batches; already-encoded `MessageBatch` objects are not re-encoded. Consumer hooks and javaagent batch instrumentation remain unchanged.\r\n\r\nFixes #15526.\r\n\r\ncc @YaoYingLong ","title":"Fix RocketMQ batch propagation with a producer wrapper"},"mode":"publish","pr":20479,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791775649,"generation":1,"max_pipelines":5,"phase":"0889b71fdc314d91894e050f82401e17","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"c3ac359b970e4e8a9b14940182a7b95a","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/ad6a64e8dc14135373bf97b7702ff40449bb2704","workflow_revision":"ad6a64e8dc14135373bf97b7702ff40449bb2704"},"run":{"attempt":1,"conclusion":"success","id":38199873447,"url":"https://github.com/trask/copilot-workflows/actions/runs/38199873447"},"schema":2,"seen_findings":["8fbbefb67165f988b07d1c733428138943e80c9dbab766a000ef18331c6165b9"],"seen_inline_findings":["058bd38889d104c4bb011d3327f7d6e3a80e1919e15116e7ff9912217bdd8547","979527c0533e94a7df8d388ef8a2a652a1fe052335e14ccfcc2927f19697032e"],"seen_missed_findings":[],"stage":"threads_settled","verification_run":{"attempt":1,"id":38201327424}}