s origin. Successful operations omit `error.type`.\n\nEXEC result elements are not treated as failure provenance. Transaction-member failures are classified only when Lettuce exposes their own command completion; older callbacks that finish on QUEUED may not expose those errors.","title":"Align Lettuce 5.1 Redis error prefixes"},"mode":"publish","pr":20793,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792721855,"generation":1,"max_pipelines":5,"phase":"facde508b2d24a619e7a10e548ea5bb4","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"48928c9f3dc24a26ad7c684b8912919c","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/98fb6cdde0b957dd9fac1921637140b3abe6e57b","workflow_revision":"98fb6cdde0b957dd9fac1921637140b3abe6e57b"},"review_request":{"baseline_review_ids":[5594974769,5602613323,5602789753,5604255901,5604383921,5604487713,5605889009,5606407142,5607754591,5607831648,5607833722,5607899565,5607995594,5608029219,5608215962,5609128138,5609160818,5609240517,5609269603,5609298239,5609345398,5609416265,5609439611,5609536077,5609794746,5609825799,5613026893,5616374009,5623326428,5623342990],"baseline_run_ids":[39891478371,39891478625,39891478628,39891478862,39891478943,39891569005],"claim":"b1922e5fb9b447318283da86b0aa96b3","owner":{"attempt":"1","run_id":"39892079146"},"recorded_at":1792724146,"sha":"61338b566d00c8b71440eddc963b809c41236a19","status":"uncertain"},"run":{"attempt":1,"conclusion":"success","id":39888831217,"url":"https://github.com/trask/copilot-workflows/actions/runs/39888831217"},"schema":2,"seen_findings":["13cbd754c23c5bb263ddec30bf5c5eac9c4884abce164854cad17460bd1ccc40"],"seen_inline_findings":["079eb6204ae883901e0224128eaf04f0005826c244a0052ebe27cab9033b8206"],"seen_missed_findings":[],"stage":"review_request_inte