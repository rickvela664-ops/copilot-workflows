320168":"32c25a6c25de2bb8e52cd9ac550578e34c81a27b"},"parent":"7fb33b681d1318b709eec0b5c6333b9359dde182","patch_sha256":"d3b5de0624a05731c620c9db65aaf0fbe3b49c29c1936298f5fc9500f596175f","tree":"82cc271354db5a7f3f610866150a4dfe5748bb9b"},"confirmed_at":1792978081,"effect":"push","generation":7,"request_id":"bae73075ea044bcba2e2961a683eb1f9","sha":"32c25a6c25de2bb8e52cd9ac550578e34c81a27b"}],"reason":"fresh_Copilot_review_request_intent","report":{"artifact_id":12620839166,"candidate":{"bundle_sha256":"f7c4fb8a4fed97d1988847b92bcf21ad4b2a0c7aadf68b3e07413de379aa47ce","changed":true,"changed_paths":["tools/database/runner/README.md","tools/database/runner/src/database_conformance/_mongodb.py","tools/database/runner/tests/test_database_backends.py"],"commit":"32c25a6c25de2bb8e52cd9ac550578e34c81a27b","commits":[{"changed_paths":["tools/database/runner/README.md","tools/database/runner/src/database_conformance/_mongodb.py","tools/database/runner/tests/test_database_backends.py"],"commit":"32c25a6c25de2bb8e52cd9ac550578e34c81a27b","parent":"7fb33b681d1318b709eec0b5c6333b9359dde182","patch_sha256":"d3b5de0624a05731c620c9db65aaf0fbe3b49c29c1936298f5fc9500f596175f","subject":"Wait for MongoDB authorization before initializing fixtures","tree":"82cc271354db5a7f3f610866150a4dfe5748bb9b"}],"cumulative_patch_sha256":"d3b5de0624a05731c620c9db65aaf0fbe3b49c29c1936298f5fc9500f596175f","finding_commits":{"inline:4373219857":"32c25a6c25de2bb8e52cd9ac550578e34c81a27b","review:5646320168":"32c25a6c25de2bb8e52cd9ac550578e34c81a27b"},"parent":"7fb33b681d1318b709eec0b5c6333b9359dde182","patch_sha256":"d3b5de0624a05731c620c9db65aaf0fbe3b49c29c1936298f5fc9500f596175f","tree":"82cc271354db5a7f3f610866150a4dfe5748bb9b"},"dispositions":{"findings":[{"analysis":"The review overview describes the same readiness race as inline:4373219857. Readiness now queries getCmdLineOpts and requires parsed.security.authorization to equal enabled, so the temporary initialization daemon is rejected before DatabaseContainer.start() runs bootstrap.","commit":1,"disposition":"fixed","key":"review:5646320168"},{"analysis":"The frozen probe accepted any successful authenticated ping, which does not establish that authorization is enabled. The probe now requires the server's parsed authorization setting to be enabled. The existing root credentials are retained. Added a backend readiness regression assertion and documented why bootstrap must wait for the final daemon. Focused lifecycle tests pass; executing the probe JavaScript rejects missing or disabled authorization and accepts enabled authorization.","commit":1,"disposition":"fixed","key":"inline:4373219857"}],"input_identity":{},"outcome":"fixes","request_digest":"fbad2b44ab14f44c3bc039662d7a3f4b232ffedde31a93fef163c230ae69313d","schema":2},"download_sha256":"c9ecdde13beed8c88d453df1151f680475894fa5cd21ad7580d7e6ac7edf058a","frozen_sha":"7fb33b681d1318b709eec0b5c6333b9359dde182","pr":136,"publication_eligible":false,"repo":"open-telemetry/semantic-conventions-conformance","request_digest":"fbad2b44ab14f44c3bc039662d7a3f4b232ffedde31a93fef163c230ae69313d","request_id":"bae73075ea044bcba2e2961a683eb1f9","run_attempt":1,"run_id":40253335145,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:c9ecdde13beed8c88d453df1151f680475894fa5cd21ad7580d7e6ac7edf058a","verification":"verified","verification_run":{"attempt":1,"id":40254157871},"workflow_revision":"f9d2af9fce01ee319295abe00856608a264119f4"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5058973750,5062269817,5062389064,5646320168],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe1 Changes recommended\n\nThe readiness probe can accept MongoDB\u2019s temporary initialization server, allowing bootstrap to race its shutdown and fail intermittently.\n\n<details open>\n<summary><strong>1 open issue</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/high-v2-light.png\" alt=\"High severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Require authorization before accepting MongoDB readiness](https://github.com/open-telemetry/semantic-conventions-conformance/pull/136#discussion_r4373219857) \u00b7 New\n</details>\n\n<sub>Review effort: Balanced</sub>","comment_id":null,"key":"review:5646320168","kind":"body","line":null,"path":null,"review_id":5646320168},{"body":"This authenticated ping can succeed against the image's temporary initialization `mongod` after the root user is created. `DatabaseContainer.start()` then immediately runs the bootstrap, which can race that server's shutdown and fail intermittently. Require authorization to be enabled before accepting readiness, since the temporary daemon runs without it and the final daemon enables it.","comment_commit_id":"7fb33b681d1318b709eec0b5c6333b9359dde182","comment_id":4373219857,"key":"inline:4373219857","kind":"inline","line":46,"original_commit_id":"7fb33b681d1318b709eec0b5c6333b9359dde182","original_line":46,"path":"tools/database/runner/src/database_conformance/_mongodb.py","review_commit_id":"7fb33b681d1318b709eec0b5c6333b9359dde182","review_id":5646320168,"review_submitted_at":"2026-10-26T01:04:17Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"731a3bd4097f52629426d867eaf3d5a04d89168dcfbda163607308ca24e4469e","id":4373219857,"parent":null,"updated_at":"2026-10-26T01:04:17Z"}],"thread_id":"PRRT_kwDOTuzK5c6wG61-"}],"frozen_at":1792977208,"frozen_at_iso":"2026-10-26T01:13:28Z","frozen_sha":"7fb33b681d1318b709eec0b5c6333b9359dde182","head_ref":"trask-add-mongodb-database-domain","head_repo":"open-telemetry/semantic-conventions-conformance","head_repo_id":1324141285,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":40251827510},"loop_kind":"copilot_review","metadata":{"body":"Adds Java MongoDB conformance for the current synchronous and Reactive Streams drivers and the final legacy async driver release, each through the Java agent and published `opentelemetry-mongo-3.1` library.\n\n- Runs deterministic `find`, `update`, `delete`, and `aggregate` workloads against a digest-pinned MongoDB 8.0 container.\n- Checks exact stable database attributes and sanitized command text, including the `endSessions` lifecycle command.\n- Adds MongoDB backend dispatch, lifecycle/error coverage, `db.mongodb.client` classification, generated coverage snapshots, docs, and Renovate tracking.\n\nThe legacy async API is intentionally pinned to 3.12.14 because that line is unmaintained and was replaced by Reactive Streams. MongoDB instrumentation currently does not emit `db.query.summary`; expectations assert that gap explicitly.","title":"Add Java MongoDB database conformance"},"mode":"publish","pr":136,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792976253,"generation":7,"max_pipelines":5,"phase":"8bec6db62d1049ada3521ea0a99b0040","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/semantic-conventions-conformance","repo_id":1324141285,"request_id":"bae73075ea044bcba2e2961a683eb1f9","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/f9d2af9fce01ee319295abe00856608a264119f4","workflow_revision":"f9d2af9fce01ee319295abe00856608a264119f4"},"review_request":{"baseline_review_ids":[5058973750,5062269817,5062389064,5646320168,5646425108],"baseline_run_ids":[40254343704,40254343765,40254344139],"claim":"18215f3e402c406aaa96c271463e4ccb","owner":{"attempt":"1","run_id":"40254157871"},"recorded_at":1792978176,"sha":"32c25a6c25de2bb8e52cd9ac550578e34c81a27b","status":"uncertain"},"run":{"attempt":1,"conclusion":"success","id":40253335145,"url":"https://github.com/trask/copilot-workflows/actions/runs/40253335145"},"schema":2,"seen_findings":["6b246feb319cbf37193c2310b541062897e7a5a52a7317f38e925fa5f5b1313f"],"seen_inline_findings":["0d2302ddd79f7cfe7fb7c89e77fdf86b1f11d1b319c7b06e00b0a6683150404b"],"seen_missed_findings":[],"stage":"review_request_intent","verification_run":{"attempt":1,"id":40254157871}}