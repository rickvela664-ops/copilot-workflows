nput_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38289846288},"loop_kind":"pr_conflict_resolver","merge_base_sha":"9613dbe6d55ce3292415a49fe35f6a105c5c93fa","metadata":{"body":"Adds Java MongoDB conformance for the current synchronous and Reactive Streams drivers and the final legacy async driver release, each through the Java agent and published `opentelemetry-mongo-3.1` library.\n\n- Runs deterministic `find`, `update`, `delete`, and `aggregate` workloads against a digest-pinned MongoDB 8.0 container.\n- Checks exact stable database attributes and sanitized command text, including the `endSessions` lifecycle command.\n- Adds MongoDB backend dispatch, lifecycle/error coverage, `db.mongodb.client` classification, generated coverage snapshots, docs, and Renovate tracking.\n\nThe legacy async API is intentionally pinned to 3.12.14 because that line is unmaintained and was replaced by Reactive Streams. MongoDB instrumentation currently does not emit `db.query.summary`; expectations assert that gap explicitly.","title":"Add Java MongoDB database conformance"},"mode":"publish","pr":136,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791829026,"generation":2,"max_pipelines":5,"phase":"b9b150ba81904bcd8028f72954e13e7b","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/semantic-conventions-conformance","repo_id":1324141285,"request_id":"0db7048e21564a0298cd60d2e6ecc85c","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/bb68514826ed27b756023e196d2f92f7e88fa58a","workflow_revision":"bb68514826ed27b756023e196d2f92f7e88fa58a"},"run":{"attempt":1,"conclusion":"success","id":38290022421,"url":"https://github.com/trask/copilot-workflows/actions/runs/38290022421"},"schema":2,"seen_findings":[],"seen_inline_findings":[],"seen_missed_findings":[],"stage":"publish_pending","verification_run":{"attempt":1,"id":38292391261}}