y pinned to 3.12.14 because that line is unmaintained and was replaced by Reactive Streams. MongoDB instrumentation currently does not emit `db.query.summary`; expectations assert that gap explicitly.","title":"Add Java MongoDB database conformance"},"mode":"publish","pr":136,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791844367,"generation":3,"max_pipelines":5,"phase":"ae8c881fa9914ec9b278e49e98e2af62","profile":"git-candidate-v1","required_checks":["Analyze (actions)","CodeQL","Coverage model","Discover scenarios","EasyCLA","Lint","Relock (${{ matrix.ecosystem }})","Scenarios (database-java)","Scenarios (gen-ai-python)","Scenarios (http-dotnet)","Scenarios (http-go)","Scenarios (http-java)","Scenarios (http-js)","Scenarios (http-php)","Scenarios (http-python)","Scenarios (http-ruby-net_http-opentelemetry-instrumentation-net_http-client)","Scenarios (http-ruby-rack-opentelemetry-instrumentation-rack-server)","Test (ubuntu-latest, Python 3.14)","Test (windows-latest, Python 3.14)","Types","Zizmor Security Analysis / Zizmor Security Analysis","required-status-check","zizmor"]},"repo":"open-telemetry/semantic-conventions-conformance","repo_id":1324141285,"request_id":"8a06d7cdfca245febc43aa808b7a88c8","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/5d6ad62b673c0c9d4746d35b84ef1beb64efd265","workflow_revision":"5d6ad62b673c0c9d4746d35b84ef1beb64efd265"},"run":null,"schema":2,"seen_findings":[],"seen_inline_findings":[],"seen_missed_findings":[],"stage":"waiting_ci"}