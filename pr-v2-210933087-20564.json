.sh","instrumentation/servlet/servlet-5.0/jetty12-testing/build.gradle.kts","instrumentation/servlet/servlet-5.0/testing/src/main/java/io/opentelemetry/instrumentation/servlet/v5_0/AbstractServlet5Test.java"],"commit":"d8703bc68daebbd08346dff68490af0698102dbb","parent":"d7e0e5d791957963dd776cafc78129dd79c7447e","patch_sha256":"6a0aad39c45cd31a24222e365f153a4e92197231f4f1a585ec219d900aded20a","subject":"Collect Servlet 5 default and request-capture profiles","tree":"9bf2faeefb03b6d0126c16363ed1a1d6ac66c5fc"}],"cumulative_patch_sha256":"6a0aad39c45cd31a24222e365f153a4e92197231f4f1a585ec219d900aded20a","finding_commits":{"review:5513312046":"d8703bc68daebbd08346dff68490af0698102dbb"},"parent":"d7e0e5d791957963dd776cafc78129dd79c7447e","patch_sha256":"6a0aad39c45cd31a24222e365f153a4e92197231f4f1a585ec219d900aded20a","tree":"9bf2faeefb03b6d0126c16363ed1a1d6ac66c5fc"},"dispositions":{"findings":[{"analysis":"The frozen Jetty 12 test enabled request-parameter capture and labeled all collected Servlet 5 telemetry with that opt-in setting, leaving no instrumentation-default profile. Repository telemetry-collection instructions and original commit 569c3306 explicitly require defaults and optional capture to be collected separately. Commit 1 moves the setting and label into testRequestParameterCapture, wires it into check and the collection list, and uses the established Servlet 3 assertion pattern to exercise both parameter presence and default absence while preserving exclude-only and library coverage. Both full Jetty 12 profiles pass, and their generated Servlet 5 metadata contains separate default and opt-in records with request-parameter attributes only in opt-in records.","commit":1,"disposition":"fixed","key":"review:5513312046"}],"input_identity":{},"outcome":"fixes","request_digest":"d38ef20b6428a0883a0f616b32c4ffcab903ede15a29f35c98e1416a8605dd52","schema":2},"download_sha256":"db4903bae49486f8a9c6c5ca8b489955bc91f321f33df5605519a2394308ffa0","frozen_sha":"d7e0e5d791