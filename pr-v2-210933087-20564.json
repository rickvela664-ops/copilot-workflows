f8b1fc67e","patch_sha256":"9deb3d68a3e9d12e6211b8308dd03915084249825d792adf78bce8ca75e34ad9","subject":"Separate Tomcat request capture from setup-only metadata","tree":"b5df3294a19b6a21232de6a4df0b610611466639"}],"cumulative_patch_sha256":"9deb3d68a3e9d12e6211b8308dd03915084249825d792adf78bce8ca75e34ad9","finding_commits":{"inline:4264181151":"bae326392c0156a39ce54f96503ebf4f0d37e2d2","review:5510155922":"bae326392c0156a39ce54f96503ebf4f0d37e2d2"},"parent":"3fa15b0fb693877091bbf93e89d2346f8b1fc67e","patch_sha256":"9deb3d68a3e9d12e6211b8308dd03915084249825d792adf78bce8ca75e34ad9","tree":"b5df3294a19b6a21232de6a4df0b610611466639"},"dispositions":{"findings":[{"analysis":"Both overview concerns were confirmed in the frozen source. Tomcat 10 now captures request parameters only in a dedicated, correctly labeled test variant, with baseline assertions checking their absence. Both Tomcat 7 and Tomcat 10 trace-ID setup variants explicitly override inherited collectMetadata to false and remain wired into check. Tomcat 10's trace-ID task is no longer a collection input. Full affected-component checks and effective Gradle task-property assertions passed.","commit":1,"disposition":"fixed","key":"review:5510155922"},{"analysis":"Removed Tomcat 10's shared request-parameter flag, added testRequestParameterCapture with the existing test-* selection and matching metadataConfig, and wired it into check and instrumentations.sh. TomcatHandlerTest now exercises capture both enabled and disabled using the existing shared HTTP test expectation. The username-only variant no longer enables or labels parameter capture. The trace-ID variant retains behavioral coverage but has no metadataConfig, overrides collection to false, and is excluded from the collection script. Generated telemetry contained request-parameter attributes only under the dedicated capture label, never under default or the username label.","commit":1,"disposition":"fixed","key":"inline:4264181151"}],"input_identity":{},"o