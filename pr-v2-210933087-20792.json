5609541436,5609695781,5609823325,5609858511,5609923088,5610093202,5610172868,5610401756,5610513991,5610515462,5610554759,5610589942,5610713463,5610917078,5610973195,5611400932,5611523788,5611595016,5611671404,5611833027,5611956600,5612109515,5612187484,5612284156,5612357573,5612866704,5620026160,5620359674,5620451249,5620654372,5620814939,5623027445,5623140277,5623239329,5623283967,5623331172,5623405546,5623464530,5623486701,5623638759,5624190425],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"[Javaagent] The nested context also hides server errors that escape a response builder and become batch results. In the supported Jedis 4.0.0 implementation, `Pipeline.syncAndReturnAll()` catches `JedisDataException` from `Response.get()` and adds it to the returned list. If a builder calls `nestedClient.get(\"wrong-type\")` without catching the exception, only this nested context records the confirmed server error. The outer batch then ends with no thrown exception and no captured error, so its span and duration metric omit `error.type` despite the failed result. Preserve confirmation for errors that escape nested operations and inspect failures returned by batch completion, without marking caught-and-handled nested errors as batch failures. Add an uncaught counterpart to `caughtNestedCommandServerErrorDoesNotFailSuccessfulOuterPipeline`.","comment_commit_id":"ad0ff6f7050c771748e6fc57f559e056065f2fc2","comment_id":4356344272,"key":"inline:4356344272","kind":"inline","line":44,"original_commit_id":"f91f081bab7e580ad39d5d8e192045a1e9565054","original_line":44,"path":"instrumentation/jedis/jedis-common/javaagent/src/main/java/io/opentelemetry/javaagent/instrumentation/jedis/common/JedisRequestContext.java","review_commit_id":"f91f081bab7e580ad39d5d8e192045a1e9565054","review_id":5624190425,"review_submitted_at":"2026-10-23T05:16:33Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"bda1e1a36272e7a6a37ed1f364d8a51276ee79c151d064250ffdd7a99215d325","id":4356344272,"parent":null,"updated_at":"2026-10-23T05:16:33Z"}],"thread_id":"PRRT_kwDODJKVX86ve0nS"}],"frozen_at":1792770069,"frozen_at_iso":"2026-10-23T15:41:09Z","frozen_sha":"ad0ff6f7050c771748e6fc57f559e056065f2fc2","head_ref":"copilot/trask-jedis-redis-server-errors","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":39980359290},"loop_kind":"copilot_review","metadata":{"body":"<!--\nCHANGELOG.md is generated from merged pull requests. Do not add an entry unless this PR introduces\na deprecation or breaking change.\n-->\n\nClassify Redis server errors for Jedis 2, 3, and 4+ on spans and database duration metrics. A confirmed `WRONGTYPE details` reply produces `error.type=\"WRONGTYPE\"`.\n\nPreserve usable ASCII prefixes verbatim. Dedicated server exceptions, non-ASCII or missing prefixes, and client failures retain exception-class fallback. Successful operations omit `error.type`.\n\nPropagate actual failures through command, pipeline, and transaction completion, including error results returned inside batches.","title":"Classify Jedis Redis server errors"},"mode":"publish","pr":20792,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792770072,"generation":4,"max_pipelines":5,"phase":"5503edea74c94e79a3e4778a4c0eb4a6","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"057b7961fdce4c52be861cbbb4c159b5","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/98fb6cdde0b957dd9fac1921637140b3abe6e57b","workflow_revision"