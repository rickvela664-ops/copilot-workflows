on_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[],"frozen_at":1792902182,"frozen_at_iso":"2026-10-25T04:23:02Z","frozen_sha":"d9de027fb00a58064a114811aee9b4a72c6047eb","head_ref":"trask-package-telemetry-windows","head_repo":"open-telemetry/semantic-conventions-conformance","head_repo_id":1324141285,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":40161669043},"loop_kind":"pr_conflict_resolver","merge_base_sha":"c01ad62dd48a39f795fcb47fb481b9e26bcb296f","metadata":{"body":"Run one Weaver live check per package while the runner captures raw OTLP in a separate window for each scenario. Scenario assertions use those captures, and Weaver reports package-wide semantic convention violations.\n\nHTTP packages now point to an independent client or server contract:\n\n```yaml\n# client\nscenario_contract: ../../../../../../tools/http/contracts/client.yaml\nscenario_run: node scenario.js\n\n# server\nscenario_contract: ../../../../../../tools/http/contracts/server.yaml\nscenario_run: otel-http-drive --serve node ../server.js\n```\n\nA contract's `driver` sets the process lifecycle. `instrumentation` runs one process per action. `runner` keeps one measured server alive and drives its actions in order through the `jsonl-v1` protocol. Language helpers receive runner-selected actions as JSON instead of reading YAML.\n\n`expected_violations` now belongs at package level, where it reconciles with the aggregate Weaver report. Each pytest package item owns the full lifecycle, and diagnostic output contains per-scenario capture reports plus one aggregate Weaver report.\n","title":"Run one Weaver check per package with isolated OTLP capture"},"mode":"publish","pr":173,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792902182,"generation":4,"max_pipelines":5,"phase":"060b7ab4f9a2409f9204357c1ffdd2d0","profile":"git-candidate-v1","required_che