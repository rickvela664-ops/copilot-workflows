n_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[],"frozen_at":1791829050,"frozen_at_iso":"2026-10-12T18:17:30Z","frozen_sha":"a4c27759a0b9eced562b90c293f918936975cb0c","head_ref":"trask-package-telemetry-windows","head_repo":"open-telemetry/semantic-conventions-conformance","head_repo_id":1324141285,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38289893847},"loop_kind":"pr_conflict_resolver","merge_base_sha":"9613dbe6d55ce3292415a49fe35f6a105c5c93fa","metadata":{"body":"Run one Weaver live check per package while the runner captures raw OTLP in a separate window for each scenario. Scenario assertions use those captures, and Weaver reports package-wide semantic convention violations.\n\nHTTP packages now point to an independent client or server contract:\n\n```yaml\n# client\nscenario_contract: ../../../../../../tools/http/contracts/client.yaml\nscenario_run: node scenario.js\n\n# server\nscenario_contract: ../../../../../../tools/http/contracts/server.yaml\nscenario_run: otel-http-drive --serve node ../server.js\n```\n\nA contract's `driver` sets the process lifecycle. `instrumentation` runs one process per action. `runner` keeps one measured server alive and drives its actions in order through the `jsonl-v1` protocol. Language helpers receive runner-selected actions as JSON instead of reading YAML.\n\n`expected_violations` now belongs at package level, where it reconciles with the aggregate Weaver report. Each pytest package item owns the full lifecycle, and diagnostic output contains per-scenario capture reports plus one aggregate Weaver report.\n","title":"Run one Weaver check per package with isolated OTLP capture"},"mode":"publish","pr":173,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1791829050,"generation":2,"max_pipelines":5,"phase":"641e55e413af48c5bd7ca6bd69b506d3","profile":"git-candidate-v1","required_chec