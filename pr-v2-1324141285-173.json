ommits":{},"parent":"38e8cc8dfe29e66dc90adfc9102d55d290fa0920","patch_sha256":"830d0d98479bc183abd79f70d71e0d22124a081bbe8c9c4d0b9f0bf28916c97f","tree":"cad1ae238ec1525efdb43e613aba6aa0752b2964"},"dispositions":{"diagnoses":[{"analysis":"The required status gate is an aggregate failure, not a separate broken command: runner.yml deliberately exits 1 when needs.scenarios.result is not success. The three failed scenario checks have concrete fixes; retain the required gate unchanged.","decision":"fix","evidence":["Complete job name: required-status-check","##[group]Run exit 1"],"key":"check:114962732438"},{"analysis":"The failed step is the generated-coverage check. Raw captures use SPAN_KIND_CLIENT/INTERNAL, but the GenAI classifier expects client/internal; its unmatched-kind fallback incorrectly records both agent types. Normalize the kind at the shared capture reader boundary and regenerate all 48 GenAI packages. Six snapshots also now correctly record raw finish_reasons/top_k attributes. Do not commit the opposite-kind agent additions from the failing CI diff.","decision":"fix","evidence":["the committed data.json files are out of date \u2014 run the scenarios and commit the result","+    \"gen_ai.invoke_agent.client\": [","+      \"gen_ai.response.finish_reasons\","],"key":"check:114957972401"},{"analysis":"Scenarios succeeded; the committed-coverage check failed because the client snapshot retained a System.Net.NameResolution scope finding although its DNS metric had already disappeared in this PR. Regenerate the client data.json. Both dotnet packages pass and reproduce the refreshed coverage.","decision":"fix","evidence":["the committed data.json files are out of date \u2014 run the scenarios and commit the result","Instrumentation scope 'System.Net.NameResolution' does not have schema_url.","@@ -73,18 +73,6 @@"],"key":"check:114957972315"},{"analysis":"Pekko completed every HTTP request, but its persistent driver exited 1 during the final agent metric flush. This PR introduces 100ms periodic metric export for persistent action windows, while the prior one-shot environment effectively disabled periodic exports. Final forceFlush can consequently race an in-flight export. Retry only the SDK exceptional skipped-flush result within the original shared budget, require an actual successful flush, and preserve trace/log ordering. Apply the same behavior to the library-owned SDK path. Real PeriodicMetricReader overlap and permanent failed-flush regressions pass, as do repeated agent and library scenario runs.","decision":"fix","evidence":["persistent driver exited with 1","Caused by: java.lang.IllegalStateException: Export is already in progress, skipping flush","metric flush did not complete within the shutdown budget"],"key":"check:114957972265"}],"input_identity":{"pr_diff_sha256":"3b003371cfff702e6bdc417ee67f3e3061317432153cd707107be738b87464f7"},"outcome":"fixes","request_digest":"83c05fea0c5bb1e8041290ca9d928afa21f6b4b096ecaf8aa268df18798300e2","rerun_run":null,"schema":2},"download_sha256":"fa8a7a0deda44820b9d90bed7b308688a601b253ba6f3cebad23d87df80d930d","frozen_sha":"38e8cc8dfe29e66dc90adfc9102d55d290fa0920","pr":173,"publication_eligible":false,"repo":"open-telemetry/semantic-conventions-conformance","request_digest":"83c05fea0c5bb1e8041290ca9d928afa21f6b4b096ecaf8aa268df18798300e2","request_id":"64088e6320e24bae9adec174fc11308c","run_attempt":1,"run_id":38317419081,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:fa8a7a0deda44820b9d90bed7b308688a601b253ba6f3cebad23d87df80d930d","verification":"verified","verification_run":{"attempt":1,"id":38321015021},"workflow_revision":"5d6ad62b673c0c9d4746d35b84ef1beb64efd265"},"request":{"authorized_actor_id":218610,"base_ref":"main","base_sha":"c01ad62dd48a39f795fcb47fb481b9e26bcb296f","baseline_review_ids":[],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minut