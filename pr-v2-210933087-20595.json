fe4fd0b133606","changed":true,"changed_paths":["instrumentation/hikaricp-3.0/testing/src/main/java/io/opentelemetry/instrumentation/hikaricp/AbstractHikariInstrumentationTest.java"],"commit":"67ea12403a5abfdd87e569c692ee45545af70280","commits":[{"changed_paths":["instrumentation/hikaricp-3.0/testing/src/main/java/io/opentelemetry/instrumentation/hikaricp/AbstractHikariInstrumentationTest.java"],"commit":"67ea12403a5abfdd87e569c692ee45545af70280","parent":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","patch_sha256":"391e21a79724ddb890912ec45bd219fee8567f4671c127cb374e62f3216c8bfb","subject":"Use bounded latch waiting in HikariCP timeout test","tree":"32cdee84bdf17d1d9959ea5e85e9bf78463ede23"}],"cumulative_patch_sha256":"391e21a79724ddb890912ec45bd219fee8567f4671c127cb374e62f3216c8bfb","finding_commits":{"inline:4274315895":"67ea12403a5abfdd87e569c692ee45545af70280","review:5522237858":"67ea12403a5abfdd87e569c692ee45545af70280"},"parent":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","patch_sha256":"391e21a79724ddb890912ec45bd219fee8567f4671c127cb374e62f3216c8bfb","tree":"32cdee84bdf17d1d9959ea5e85e9bf78463ede23"},"confirmed_at":1792002915,"effect":"push","generation":1,"request_id":"269fc766b0584383a367e9c944c861b6","sha":"67ea12403a5abfdd87e569c692ee45545af70280"}],"reason":"pending_fresh_trusted_personal_acceptance","report":{"artifact_id":11919053364,"candidate":{"bundle_sha256":"b0dd42d560b80db3d7f562b900a82ca050d0015119c46922ab3fe4fd0b133606","changed":true,"changed_paths":["instrumentation/hikaricp-3.0/testing/src/main/java/io/opentelemetry/instrumentation/hikaricp/AbstractHikariInstrumentationTest.java"],"commit":"67ea12403a5abfdd87e569c692ee45545af70280","commits":[{"changed_paths":["instrumentation/hikaricp-3.0/testing/src/main/java/io/opentelemetry/instrumentation/hikaricp/AbstractHikariInstrumentationTest.java"],"commit":"67ea12403a5abfdd87e569c692ee45545af70280","parent":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","patch_sha256":"391e21a79724ddb890912ec45bd219fee8567f4671c127cb374e62f3216c8bfb","subject":"Use bounded latch waiting in HikariCP timeout test","tree":"32cdee84bdf17d1d9959ea5e85e9bf78463ede23"}],"cumulative_patch_sha256":"391e21a79724ddb890912ec45bd219fee8567f4671c127cb374e62f3216c8bfb","finding_commits":{"inline:4274315895":"67ea12403a5abfdd87e569c692ee45545af70280","review:5522237858":"67ea12403a5abfdd87e569c692ee45545af70280"},"parent":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","patch_sha256":"391e21a79724ddb890912ec45bd219fee8567f4671c127cb374e62f3216c8bfb","tree":"32cdee84bdf17d1d9959ea5e85e9bf78463ede23"},"dispositions":{"findings":[{"analysis":"The frozen overview identifies exactly one open finding: polling the connection-start latch instead of using a bounded latch wait. Candidate commit 1 resolves that same finding with assertThat(connectionAttemptStarted.await(10, SECONDS)).isTrue() and an explicit InterruptedException declaration. The existing latch release, single on-demand connection, and shutdown login timeout remain intact; both HikariCP module suites passed.","commit":1,"disposition":"fixed","key":"review:5522237858"},{"analysis":"The frozen getCount() polling violates the direct latch-wait guidance in .github/agents/knowledge/testing-general-patterns.md:130-134 and differs from AbstractNatsDispatcherTest.java:59. Candidate commit 1 replaces it with a direct ten-second bounded await and declares SQLException and InterruptedException, matching the neighboring HikariCP tests. An initial throws Exception declaration failed Error Prone's InterruptedExceptionSwallowed check, so explicit checked types are necessary. The finally block still releases the connection attempt on timeout, failure, or interruption. Formatting, Checkstyle, and all 21 library/javaagent module tests passed.","commit":1,"disposition":"fixed","key":"inline:4274315895"}],"input_identity":{},"outcome":"fixes","request_digest":"25fa8006a87734190ce68eba6ae9a25debbe707d52c9c226547ad68e35a15cd3","schema":2},"download_sha256":"51f59a35fc71df9955b2e1981abd1758b6c739049fdfd165c225f3c6ae77e19d","frozen_sha":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","pr":20595,"publication_eligible":false,"repo":"open-telemetry/opentelemetry-java-instrumentation","request_digest":"25fa8006a87734190ce68eba6ae9a25debbe707d52c9c226547ad68e35a15cd3","request_id":"269fc766b0584383a367e9c944c861b6","run_attempt":1,"run_id":38612215843,"schema":2,"scope":"Structural/Git verification only. No target code or tests are executed.","server_artifact_digest":"sha256:51f59a35fc71df9955b2e1981abd1758b6c739049fdfd165c225f3c6ae77e19d","verification":"verified","verification_run":{"attempt":1,"id":38616171978},"workflow_revision":"d8cf99923de07725fc1445b4f027c036f709d640"},"request":{"authorized_actor_id":218610,"baseline_review_ids":[5522237858],"budgets":{"max_iterations":5,"propagation_seconds":120,"retention_days":14,"worker_timeout_minutes":30},"commit_author":{"id":218610,"login":"trask"},"findings":[{"body":"<!-- ccr-overview-v2 -->\n\n### \ud83d\udfe2 Approval recommended\n\nThe cleanup behavior is sound; only a non-blocking latch-wait convention issue remains.\n\n<details open>\n<summary><strong>1 open finding</strong></summary>\n\n- <picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.svg\"><img src=\"https://github.githubassets.com/static/images/icons/copilot-code-review/low-v2-light.png\" alt=\"Low severity\" width=\"62\" height=\"18\" align=\"texttop\"></picture> [Use latch waiting instead of polling getCount()](https://github.com/open-telemetry/opentelemetry-java-instrumentation/pull/20595#discussion_r4274315895) \u00b7 New\n</details>\n\n<details>\n<summary><strong>What changed in this PR</strong></summary>\n\nMakes HikariCP timeout-test cleanup deterministic by coordinating connection creation and shutdown.\n\n**Changes:**\n- Replaces fixed sleeping with latch-controlled blocking.\n- Limits the pool to one on-demand connection.\n- Ensures shutdown waits for connection creation to drain.\n\n| File | Description |\r\n| ---- | ----------- |\r\n| `AbstractHikariInstrumentationTest.java` | Stabilizes timeout setup and cleanup behavior. |\n</details>\n\n\ud83e\udde0 **Review effort:** Balanced\n\n---\n\n\ud83d\udca1 <a href=\"/open-telemetry/opentelemetry-java-instrumentation/new/main?filename=.github/skills/code-review/SKILL.md\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Add a `code-review` agent skill</a> or configure MCP servers for context-aware, tailored reviews. <a href=\"https://docs.github.com/copilot/how-tos/use-copilot-agents/request-a-code-review/use-code-review?tool=webui#mcp-servers-and-agent-skills\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Learn more in the docs.</a>","comment_id":null,"key":"review:5522237858","kind":"body","line":null,"path":null,"review_id":5522237858},{"body":"[Testing] Polling `getCount()` with Awaitility bypasses the repository's latch-wait convention and obscures that this is a bounded callback wait. Please use `assertThat(connectionAttemptStarted.await(timeout, unit)).isTrue()` and update the test's checked-exception declaration accordingly.","comment_commit_id":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","comment_id":4274315895,"key":"inline:4274315895","kind":"inline","line":149,"original_commit_id":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","original_line":149,"path":"instrumentation/hikaricp-3.0/testing/src/main/java/io/opentelemetry/instrumentation/hikaricp/AbstractHikariInstrumentationTest.java","review_commit_id":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","review_id":5522237858,"review_submitted_at":"2026-10-14T17:51:40Z","root_author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"thread_context":[{"author":{"id":175728472,"node_id":"BOT_kgDOCnlnWA","type":"Bot"},"body_hash":"b0c9984af807f879f3998e950f0f1746901c188d2693780d213c243f4e73cffc","id":4274315895,"parent":null,"updated_at":"2026-10-14T17:51:40Z"}],"thread_id":"PRRT_kwDODJKVX86scnpH"}],"frozen_at":1792001109,"frozen_at_iso":"2026-10-14T18:05:09Z","frozen_sha":"ff26aa3abf4c1131513d6a0cc9f30a28588bc521","head_ref":"copilot/timeout-test-cleanup-deterministic","head_repo":"open-telemetry/opentelemetry-java-instrumentation","head_repo_id":210933087,"input_mode":"direct","launch_run":{"actor_id":218610,"attempt":1,"id":38612114986},"loop_kind":"copilot_review","metadata":{"body":"A timed-out connection attempt could outlive its test and emit metrics into a subsequent test.\n\n- **Timeout fixture:** Replace the fixed sleep with latch-controlled blocking and limit the pool to one on-demand connection.\n- **Cleanup:** Release the attempt in `finally` and configure Hikari\u2019s shutdown wait so its connection worker drains before cleanup completes.","title":"Make HikariCP timeout test cleanup deterministic"},"mode":"publish","pr":20595,"pr_author_id":198982749,"protocol":"git-candidate-v1","publication":{"auth_mode":"fine_grained_pat","authorized_actor_id":218610,"authorized_at":1792001111,"generation":1,"max_pipelines":5,"phase":"4a3e443a75424e739657245d539e4a2f","profile":"git-candidate-v1","required_checks":[]},"repo":"open-telemetry/opentelemetry-java-instrumentation","repo_id":210933087,"request_id":"269fc766b0584383a367e9c944c861b6","schema":2,"source_private":false,"target_private":false,"workflow_ref":"review-loop-revisions/d8cf99923de07725fc1445b4f027c036f709d640","workflow_revision":"d8cf99923de07725fc1445b4f027c036f709d640"},"run":{"attempt":1,"conclusion":"success","id":38612215843,"url":"https://github.com/trask/copilot-workflows/actions/runs/38612215843"},"schema":2,"seen_findings":["b4f81e8b66d7872835b1a4f35f20cecc0c54b005f4b46f07822e1fb76f3de7e7"],"seen_inline_findings":["380d506de50b0ae2859d13b948ab4ff27a2d819d800587af23